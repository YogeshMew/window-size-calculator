---
/**
 * WindowMetrics — Tool Card
 *
 * Premium card component for tool grids.
 * Live tools: stronger border, full clickable surface, arrow CTA, use-case chips.
 * Coming-soon / planned: muted border, no hover, opacity dimmed.
 *
 * Props:
 *   tool    — Tool from the registry (includes optional useCases[])
 *   variant — 'default' | 'compact'
 */

import ToolIcon from '@/components/ui/ToolIcon.astro';
import type { Tool } from '@/types/content.js';

interface Props {
  tool: Tool;
  variant?: 'default' | 'compact';
}

const { tool, variant = 'default' } = Astro.props;

const isLive       = tool.status === 'live';
const isComingSoon = tool.status === 'coming-soon';
const badgeLabel   = isLive ? 'Available' : isComingSoon ? 'Coming soon' : 'Planned';
---

<article class:list={['tc', `tc--${variant}`, { 'tc--live': isLive }]}>
  {
    isLive ? (
      <a href={tool.href} class="tc-inner" aria-label={`Open ${tool.title}`}>
        <div class="tc-top">
          <div class="tc-icon-wrap">
            <ToolIcon name={tool.icon ?? 'Ruler'} size={16} />
          </div>
          <span class="tc-badge tc-badge--live">{badgeLabel}</span>
        </div>
        <div class="tc-body">
          <h3 class="tc-title">{tool.title}</h3>
          <p class="tc-desc">{tool.description}</p>
        </div>
        {tool.benefits && tool.benefits.length > 0 ? (
          <ul class="tc-benefits" aria-label="What you get">
            {tool.benefits.map((b) => (
              <li class="tc-benefit-item">
                <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true" class="tc-benefit-check">
                  <path d="M1.5 5.5L4 8L9.5 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        ) : tool.useCases && tool.useCases.length > 0 ? (
          <div class="tc-chips" aria-label="Use cases">
            {tool.useCases.map((uc) => (
              <span class="tc-chip">{uc}</span>
            ))}
          </div>
        ) : null}
        <div class="tc-cta">
          <span>Open calculator</span>
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" class="tc-arrow">
            <path d="M1 6h10M7 2l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </a>
    ) : (
      <div class="tc-inner" role="article" aria-label={`${tool.title} — ${badgeLabel}`}>
        <div class="tc-top">
          <div class="tc-icon-wrap">
            <ToolIcon name={tool.icon ?? 'Ruler'} size={16} />
          </div>
          <span class="tc-badge tc-badge--pending">{badgeLabel}</span>
        </div>
        <div class="tc-body">
          <h3 class="tc-title">{tool.title}</h3>
          <p class="tc-desc">{tool.description}</p>
        </div>
        <p class="tc-pending-note">
          {isComingSoon
            ? 'This calculator is being built — check back soon.'
            : 'Planned for a future release.'}
        </p>
      </div>
    )
  }
</article>

<style>
  .tc {
    height: 100%;
  }

  .tc-inner {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    height: 100%;
    padding: var(--spacing-md);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
  }

  /* Live card — stronger default appearance */
  .tc--live .tc-inner {
    border-color: var(--color-hairline-strong);
    cursor: pointer;
  }

  .tc--live a.tc-inner:hover {
    border-color: color-mix(in srgb, var(--color-ink) 30%, transparent);
    box-shadow:
      0 2px 4px color-mix(in srgb, var(--color-ink) 4%, transparent),
      0 6px 16px color-mix(in srgb, var(--color-ink) 6%, transparent);
    transform: translateY(-2px);
  }

  .tc--live a.tc-inner:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
    border-color: var(--color-link);
  }

  .tc--live a.tc-inner:active {
    transform: translateY(0);
    box-shadow: none;
    transition-duration: 60ms;
  }

  /* Planned / coming-soon — dimmed */
  .tc:not(.tc--live) .tc-inner {
    opacity: 0.6;
    cursor: default;
  }

  /* Top row: icon + badge */
  .tc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-xs);
  }

  /* Icon wrapper */
  .tc-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background-color: color-mix(in srgb, var(--color-ink) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-ink) 9%, transparent);
    color: var(--color-ink);
    flex-shrink: 0;
    transition: background-color 150ms ease;
  }

  .tc--live a.tc-inner:hover .tc-icon-wrap {
    background-color: color-mix(in srgb, var(--color-ink) 10%, transparent);
  }

  /* Body */
  .tc-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .tc-title {
    font-size: var(--font-size-body-sm);
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 0;
  }

  .tc-desc {
    font-size: var(--font-size-caption);
    color: var(--color-body);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tc-pending-note {
    font-family: var(--font-family-mono);
    font-size: 10px;
    color: var(--color-muted);
    margin: auto 0 0;
    padding-top: var(--spacing-xs);
    line-height: 1.5;
    letter-spacing: 0.02em;
    opacity: 0.8;
  }

  /* Benefit list — checkmark items for live tools */
  .tc-benefits {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--spacing-sm);
    margin-top: 2px;
  }

  .tc-benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    font-size: var(--font-size-caption);
    color: var(--color-body);
    line-height: 1.4;
  }

  .tc-benefit-check {
    color: #16a34a;
    flex-shrink: 0;
    margin-top: 1px;
  }

  [data-theme='dark'] .tc-benefit-check {
    color: #4ade80;
  }

  /* Use-case chips */
  .tc-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 2px;
  }

  .tc-chip {
    font-size: 10px;
    font-family: var(--font-family-mono);
    color: var(--color-muted);
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: 3px;
    padding: 1px 5px;
    white-space: nowrap;
    letter-spacing: 0.02em;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .tc--live a.tc-inner:hover .tc-chip {
    color: var(--color-body);
    border-color: var(--color-hairline-strong);
  }

  /* CTA row */
  .tc-cta {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-family: var(--font-family-mono);
    color: var(--color-muted);
    margin-top: auto;
    padding-top: var(--spacing-xs);
    border-top: 1px solid var(--color-hairline);
    transition: color 150ms ease;
  }

  .tc--live a.tc-inner:hover .tc-cta {
    color: var(--color-link);
  }

  .tc-arrow {
    flex-shrink: 0;
    transition: transform 150ms ease;
  }

  .tc--live a.tc-inner:hover .tc-arrow {
    transform: translateX(2px);
  }

  /* Badges */
  .tc-badge {
    font-size: 10px;
    font-family: var(--font-family-mono);
    font-weight: 500;
    padding: 2px 6px;
    border-radius: 3px;
    white-space: nowrap;
    flex-shrink: 0;
    letter-spacing: 0.03em;
  }

  .tc-badge--live {
    color: #16a34a;
    background-color: color-mix(in srgb, #22c55e 10%, transparent);
    border: 1px solid color-mix(in srgb, #22c55e 18%, transparent);
  }

  [data-theme='dark'] .tc-badge--live {
    color: #4ade80;
    background-color: color-mix(in srgb, #22c55e 12%, transparent);
    border-color: color-mix(in srgb, #22c55e 20%, transparent);
  }

  .tc-badge--pending {
    color: var(--color-muted);
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
  }

  /* Compact variant */
  .tc--compact .tc-inner {
    padding: var(--spacing-sm) var(--spacing-md);
    gap: var(--spacing-xs);
  }

  .tc--compact .tc-desc,
  .tc--compact .tc-chips,
  .tc--compact .tc-cta {
    display: none;
  }
</style>
