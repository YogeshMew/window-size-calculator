---
/**
 * WindowMetrics — Empty State (v2)
 *
 * Shown in the results panel when no input has been entered, input is invalid,
 * or a calculation is unavailable.
 *
 * Props:
 *   id        — HTML id for JS targeting (default: "results-empty")
 *   title     — Primary message (default: "Enter dimensions")
 *   sub       — Secondary message below the title
 *   icon      — Which SVG icon to display ('window' | 'ruler' | 'search')
 *   checklist — Optional step list to help user get started
 */

interface Props {
  id?: string;
  title?: string;
  sub?: string;
  icon?: 'window' | 'ruler' | 'search';
  checklist?: string[];
}

const {
  id = 'results-empty',
  title = 'Enter dimensions',
  sub = 'Results will appear here as you type',
  icon = 'window',
  checklist,
} = Astro.props;
---

<div class="results-empty-state" id={id}>
  <div class="empty-illustration" aria-hidden="true">
    {icon === 'window' && (
      <svg width="48" height="48" viewBox="0 0 48 48" fill="none" class="empty-svg">
        <!-- Outer frame -->
        <rect x="8" y="6" width="32" height="36" rx="3" stroke="currentColor" stroke-width="1.5"/>
        <!-- Horizontal divider -->
        <line x1="8" y1="24" x2="40" y2="24" stroke="currentColor" stroke-width="1.5"/>
        <!-- Vertical divider -->
        <line x1="24" y1="6" x2="24" y2="42" stroke="currentColor" stroke-width="1.5"/>
        <!-- Pane glints -->
        <rect x="10" y="8" width="12" height="14" rx="1" fill="currentColor" opacity="0.05"/>
        <rect x="26" y="8" width="12" height="14" rx="1" fill="currentColor" opacity="0.05"/>
        <rect x="10" y="26" width="12" height="14" rx="1" fill="currentColor" opacity="0.05"/>
        <rect x="26" y="26" width="12" height="14" rx="1" fill="currentColor" opacity="0.05"/>
        <!-- Width arrow -->
        <line x1="12" y1="44" x2="36" y2="44" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2,2"/>
        <!-- Height arrow -->
        <line x1="43" y1="9" x2="43" y2="39" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2,2"/>
      </svg>
    )}
    {icon === 'ruler' && (
      <svg width="48" height="48" viewBox="0 0 48 48" fill="none" class="empty-svg">
        <rect x="6" y="18" width="36" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/>
        <line x1="13" y1="22" x2="13" y2="30" stroke="currentColor" stroke-width="1.2"/>
        <line x1="20" y1="24" x2="20" y2="30" stroke="currentColor" stroke-width="1.2"/>
        <line x1="27" y1="22" x2="27" y2="30" stroke="currentColor" stroke-width="1.2"/>
        <line x1="34" y1="24" x2="34" y2="30" stroke="currentColor" stroke-width="1.2"/>
      </svg>
    )}
    {icon === 'search' && (
      <svg width="48" height="48" viewBox="0 0 48 48" fill="none" class="empty-svg">
        <circle cx="21" cy="21" r="12" stroke="currentColor" stroke-width="1.5"/>
        <line x1="30" y1="30" x2="42" y2="42" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    )}
  </div>

  <p class="empty-title">{title}</p>
  <p class="empty-sub">{sub}</p>

  {checklist && checklist.length > 0 && (
    <ol class="empty-checklist" aria-label="Getting started">
      {checklist.map((step) => (
        <li class="empty-check-item">{step}</li>
      ))}
    </ol>
  )}
</div>

<style>
  .results-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-4xl) var(--spacing-xl);
    color: var(--color-muted);
    text-align: center;
  }

  .empty-illustration {
    color: var(--color-hairline-strong);
    margin-bottom: var(--spacing-xs);
  }

  .empty-svg {
    display: block;
  }

  .empty-title {
    font-size: var(--font-size-body-sm);
    font-weight: 500;
    color: var(--color-muted);
    margin: 0;
  }

  .empty-sub {
    font-size: var(--font-size-caption);
    color: var(--color-muted);
    opacity: 0.7;
    margin: 0;
    max-width: 240px;
    line-height: 1.5;
  }

  /* Optional checklist */
  .empty-checklist {
    list-style: none;
    padding: 0;
    margin: var(--spacing-sm) 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
  }

  .empty-check-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--font-size-caption);
    color: var(--color-muted);
    counter-increment: check-step;
  }

  .empty-check-item::before {
    content: counter(check-step);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    font-family: var(--font-family-mono);
    font-size: 9px;
    font-weight: 600;
    color: var(--color-muted);
    flex-shrink: 0;
  }
</style>
