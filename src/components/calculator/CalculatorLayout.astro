---
/**
 * WindowMetrics — Calculator Layout
 *
 * Panel-based two-column dashboard layout for calculator pages.
 * Successor to CalculatorShell.astro; mirrors the Window Size Calculator's
 * exact panel design so future calculators are pixel-consistent.
 *
 * Named slots:
 *   inputs          — Left panel: unit selector, input fields, validation banner
 *   guide           — Left panel bottom: how-to guide, diagram, tips
 *   results         — Right panel: empty state, result cards
 *   recommendations — Right panel bottom: smart recommendations section
 *
 * Props:
 *   inputsLabel  — Panel header text for the left panel (default: "Dimensions")
 *   inputsHint   — Panel header hint for the left panel (default: "All units supported")
 *   resultsLabel — Panel header text for the right panel (default: "Results")
 *   resultsHint  — Panel header hint / unit display (default: empty; updated by JS)
 *   resultsHintId — HTML id for the results hint span (for JS to update current unit)
 *   ariaLabel    — aria-label for the outer calculator container
 */

interface Props {
  inputsLabel?: string;
  inputsHint?: string;
  resultsLabel?: string;
  resultsHint?: string;
  resultsHintId?: string;
  ariaLabel?: string;
}

const {
  inputsLabel = 'Dimensions',
  inputsHint = 'All units supported',
  resultsLabel = 'Results',
  resultsHint,
  resultsHintId = 'results-unit-display',
  ariaLabel = 'Calculator',
} = Astro.props;
---

<div class="calc-dashboard" aria-label={ariaLabel}>

  <!-- LEFT PANEL — Inputs -->
  <div class="calc-panel calc-panel-inputs">
    <div class="panel-header">
      <span class="panel-label">{inputsLabel}</span>
      <span class="panel-hint">{inputsHint}</span>
    </div>
    <slot name="inputs" />
    <slot name="guide" />
  </div>

  <!-- RIGHT PANEL — Results -->
  <div class="calc-panel calc-panel-results" aria-label="Calculation results" aria-live="polite">
    <div class="panel-header">
      <span class="panel-label">{resultsLabel}</span>
      <span class="panel-hint" id={resultsHintId}>{resultsHint ?? '—'}</span>
    </div>
    <slot name="results" />
    <slot name="recommendations" />
  </div>

</div>

<style>
  .calc-dashboard {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-canvas);
  }

  @media (min-width: 768px) {
    .calc-dashboard {
      grid-template-columns: minmax(280px, 380px) 1fr;
    }
  }

  .calc-panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .calc-panel-inputs {
    border-right: 1px solid var(--color-hairline);
  }

  .calc-panel-results {
    display: flex;
    flex-direction: column;
  }

  /* Panel header */
  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-sm) var(--spacing-md);
    border-bottom: 1px solid var(--color-hairline);
    background-color: var(--color-canvas-soft);
    flex-shrink: 0;
  }

  .panel-label {
    font-family: var(--font-family-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .panel-hint {
    font-family: var(--font-family-mono);
    font-size: 11px;
    color: var(--color-muted);
    opacity: 0.7;
  }

  /* Slot for InputCard overrides — removes duplicate borders when stacked in panel */
  :global(.calc-panel-inputs .input-card) {
    border: none;
    border-bottom: 1px solid var(--color-hairline);
    border-radius: 0;
    box-shadow: none;
    background: transparent;
  }
</style>
