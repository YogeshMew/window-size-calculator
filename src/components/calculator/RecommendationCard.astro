---
/**
 * WindowMetrics — Recommendation Card
 *
 * A single block inside the "Smart recommendations" section.
 * Renders the card wrapper, header row (label + optional badge), and footer note.
 * All inner content (comparison tables, two-column grids, etc.) is passed via <slot>.
 *
 * Variants:
 *   'default'   — standard card with label + slot content
 *   'next-step' — compact inline card with label on left and action link on right
 *
 * Named slots:
 *   badge       — Optional badge element in the header row (e.g. <span id="rec-std-badge" ...>)
 *   (default)   — Inner content (comparison rows, two-column grids, etc.)
 *   note        — Optional footer note (alternative to noteId/noteText props)
 *
 * Props:
 *   label    — Section label shown in monospace uppercase (required)
 *   badgeId  — HTML id for the badge element (populated by JS)
 *   noteId   — HTML id for the footer <p> (populated by JS)
 *   noteText — Static footer note text (when id-based JS update is not needed)
 *   variant  — Card layout variant
 */

interface Props {
  label: string;
  badgeId?: string;
  noteId?: string;
  noteText?: string;
  variant?: 'default' | 'next-step';
}

const { label, badgeId, noteId, noteText, variant = 'default' } = Astro.props;
---

<div class:list={['rec-card', { 'rec-card--next': variant === 'next-step' }]}>
  <div class="rec-card-top">
    <span class="rec-card-label">{label}</span>
    {badgeId && <span id={badgeId} class="rec-badge">—</span>}
    <slot name="badge" />
  </div>
  <slot />
  {noteId && <p id={noteId} class="rec-card-note">{noteText ?? ''}</p>}
  {!noteId && noteText && <p class="rec-card-note">{noteText}</p>}
  <slot name="note" />
</div>

<style>
  .rec-card {
    padding: var(--spacing-md);
    border-bottom: 1px solid var(--color-hairline);
  }

  .rec-card:last-child {
    border-bottom: none;
  }

  .rec-card--next {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    background-color: var(--color-canvas-soft);
  }

  .rec-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xs);
  }

  /* In next-step variant the top div is not rendered — label sits directly in the flex row */
  .rec-card--next .rec-card-top {
    margin-bottom: 0;
  }

  .rec-card-label {
    font-family: var(--font-family-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .rec-card-note {
    font-size: var(--font-size-caption);
    color: var(--color-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* Badge */
  .rec-badge {
    font-family: var(--font-family-mono);
    font-size: 10px;
    padding: 1px 6px;
    border-radius: 3px;
    border: 1px solid var(--color-hairline);
    background-color: var(--color-canvas-soft-2);
    color: var(--color-muted);
    flex-shrink: 0;
    letter-spacing: 0.03em;
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
  }

  .rec-badge[data-type='exact'] {
    background-color: color-mix(in srgb, #22c55e 10%, transparent);
    border-color: color-mix(in srgb, #22c55e 20%, transparent);
    color: #16a34a;
  }

  :global([data-theme='dark']) .rec-badge[data-type='exact'] {
    color: #4ade80;
  }

  .rec-badge[data-type='close'] {
    background-color: color-mix(in srgb, #f59e0b 10%, transparent);
    border-color: color-mix(in srgb, #f59e0b 20%, transparent);
    color: #b45309;
  }

  :global([data-theme='dark']) .rec-badge[data-type='close'] {
    color: #fbbf24;
  }

  .rec-badge[data-type='far'] {
    background-color: var(--color-canvas-soft-2);
    color: var(--color-muted);
    border-color: var(--color-hairline);
  }
</style>
