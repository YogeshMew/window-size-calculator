---
/**
 * WindowMetrics — Result Metric Card
 *
 * Enhanced result card with animated number transitions, rich context,
 * optional badge, and optional icon. Backward-compatible with ResultCard.astro
 * (same DOM element classes: .result-value-text, .result-unit).
 *
 * Props:
 *   id          — HTML id (required for JS live updates)
 *   label       — Metric name (e.g. "Window Area")
 *   value       — Initial display value (default: "—")
 *   unit        — Unit suffix (e.g. "sq ft")
 *   sublabel    — Small secondary note below value
 *   context     — "Useful for" explanatory text or array of use-cases
 *   highlight   — Primary result style (stronger border, larger font)
 *   animate     — Enable number counter animation on value change
 *   badge       — Small badge label shown inline with the metric label
 *   badgeType   — Badge colour: 'neutral' | 'positive' | 'warning'
 *   usedFor     — Array of tags (chips) shown below value
 *   class       — Additional CSS class
 */

interface Props {
  id?: string;
  label: string;
  value?: string;
  unit?: string;
  sublabel?: string;
  context?: string | string[];
  highlight?: boolean;
  animate?: boolean;
  badge?: string;
  badgeType?: 'neutral' | 'positive' | 'warning';
  usedFor?: string[];
  class?: string;
}

const {
  id,
  label,
  value = '—',
  unit,
  sublabel,
  context,
  highlight = false,
  animate = true,
  badge,
  badgeType = 'neutral',
  usedFor,
  class: className,
} = Astro.props;

const contextArr = Array.isArray(context)
  ? context
  : context
  ? [context]
  : undefined;
---

<div
  class:list={[
    'rmc',
    { 'rmc--highlight': highlight, 'rmc--animate': animate },
    className,
  ]}
  id={id}
  data-animate={animate}
>
  <!-- Label row -->
  <div class="rmc-label-row">
    <span class="rmc-label">{label}</span>
    {badge && (
      <span class:list={['rmc-badge', `rmc-badge--${badgeType}`]}>{badge}</span>
    )}
  </div>

  <!-- Value -->
  <p class="rmc-value">
    <span class="result-value-text">{value}</span><span class="result-unit">{unit ?? ''}</span>
  </p>

  {sublabel && <p class="rmc-sublabel">{sublabel}</p>}

  <!-- Context: use cases -->
  {contextArr && contextArr.length > 0 && (
    <div class="rmc-context">
      <span class="rmc-context-label">Useful for</span>
      <ul class="rmc-context-list">
        {contextArr.map((item) => (
          <li class="rmc-context-item">
            <svg width="8" height="8" viewBox="0 0 8 8" fill="none" aria-hidden="true">
              <circle cx="4" cy="4" r="1.5" fill="currentColor"/>
            </svg>
            {item}
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- Legacy tags (backward compat) -->
  {usedFor && usedFor.length > 0 && (
    <div class="rmc-tags">
      {usedFor.map((tag) => (
        <span class="rmc-tag">{tag}</span>
      ))}
    </div>
  )}

  <!-- Slot for extra content -->
  <slot />
</div>

<style>
  .rmc {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: var(--spacing-md) var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: border-color 150ms ease;
  }

  .rmc:hover {
    border-color: color-mix(in srgb, var(--color-ink) 16%, transparent);
  }

  /* Label row */
  .rmc-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-xs);
  }

  .rmc-label {
    font-family: var(--font-family-mono);
    font-size: 11px;
    font-weight: 400;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  /* Inline badge */
  .rmc-badge {
    font-family: var(--font-family-mono);
    font-size: 10px;
    padding: 1px 6px;
    border-radius: 3px;
    flex-shrink: 0;
    letter-spacing: 0.03em;
  }

  .rmc-badge--neutral {
    color: var(--color-muted);
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
  }

  .rmc-badge--positive {
    color: #16a34a;
    background-color: color-mix(in srgb, #22c55e 10%, transparent);
    border: 1px solid color-mix(in srgb, #22c55e 18%, transparent);
  }

  [data-theme='dark'] .rmc-badge--positive {
    color: #4ade80;
  }

  .rmc-badge--warning {
    color: #b45309;
    background-color: color-mix(in srgb, #f59e0b 10%, transparent);
    border: 1px solid color-mix(in srgb, #f59e0b 18%, transparent);
  }

  [data-theme='dark'] .rmc-badge--warning {
    color: #fbbf24;
  }

  /* Value */
  .rmc-value {
    font-size: var(--font-size-display-md);
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: var(--tracking-display-md);
    line-height: 1.1;
    margin: 0;
    font-family: var(--font-family-mono);
  }

  /* result-value-text & result-unit classes kept for JS compatibility */
  :global(.result-value-text) {
    /* value portion — updated by JS */
  }

  :global(.result-unit) {
    font-size: var(--font-size-body-sm);
    font-weight: 400;
    color: var(--color-muted);
    margin-left: 5px;
    font-family: var(--font-family-sans);
    letter-spacing: 0;
  }

  /* Animation: brief highlight flash when value changes */
  @media (prefers-reduced-motion: no-preference) {
    .rmc--animate .rmc-value {
      transition: color 120ms ease;
    }
  }

  .rmc-sublabel {
    font-size: var(--font-size-caption);
    color: var(--color-muted);
    margin: 2px 0 0;
    line-height: 1.4;
  }

  /* Context block */
  .rmc-context {
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid var(--color-hairline);
  }

  .rmc-context-label {
    font-family: var(--font-family-mono);
    font-size: 9px;
    font-weight: 500;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 4px;
  }

  .rmc-context-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 3px 10px;
  }

  .rmc-context-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: var(--font-size-caption);
    color: var(--color-body);
    line-height: 1.4;
  }

  .rmc-context-item svg {
    color: var(--color-muted);
    flex-shrink: 0;
  }

  /* Tags (legacy usedFor) */
  .rmc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: var(--spacing-xs);
  }

  .rmc-tag {
    font-size: 10px;
    font-family: var(--font-family-mono);
    color: var(--color-muted);
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: 3px;
    padding: 1px 5px;
    letter-spacing: 0.03em;
  }

  /* Highlight variant — primary metric */
  .rmc--highlight {
    border-color: color-mix(in srgb, var(--color-ink) 20%, transparent);
    background-color: var(--color-canvas-soft);
  }

  .rmc--highlight .rmc-value {
    font-size: var(--font-size-display-lg);
  }

  .rmc--highlight .rmc-label {
    color: var(--color-body);
  }
</style>
