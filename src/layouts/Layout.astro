---
/**
 * WindowMetrics — Base Layout
 *
 * Applied to every page. Provides:
 * - Dark mode FOUC prevention script (must be first)
 * - Full <head> with SEO, canonical, OG, Twitter meta
 * - Geist font loading
 * - Global styles
 * - SkipLink (accessibility)
 * - Header + main slot + Footer
 *
 * Props:
 *   title       — Page title (without site name suffix)
 *   description — Meta description
 *   canonical   — Canonical URL (full path)
 *   ogImage     — OG image path (optional)
 *   noindex     — true to add noindex meta
 *   jsonLd      — Pre-serialized JSON-LD script tags (use toJsonLd())
 *   class       — Additional classes on <body>
 */

import '@/styles/app.css';
import Header from '@/components/global/Header.astro';
import Footer from '@/components/global/Footer.astro';
import SkipLink from '@/components/global/SkipLink.astro';
import { buildTitle, buildOGMeta, buildTwitterMeta } from '@/lib/seo.js';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  noindex?: boolean;
  /** Pre-serialized JSON-LD script tags — use toJsonLd() from @/lib/jsonld */
  jsonLd?: string;
  class?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false,
  jsonLd,
  class: className,
} = Astro.props;

const fullTitle = buildTitle(title);
const ogMeta = buildOGMeta({ title: fullTitle, description, url: canonical, image: ogImage });
const twitterMeta = buildTwitterMeta({ title: fullTitle, description, image: ogImage });
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    {ogMeta.map((m) => <meta property={m.property} content={m.content} />)}

    <!-- Twitter Card -->
    {twitterMeta.map((m) => <meta name={m.name} content={m.content} />)}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- JSON-LD Structured Data -->
    {jsonLd && <Fragment set:html={jsonLd} />}

    <!-- Additional head slots -->
    <slot name="head" />
  </head>

  <body class={className}>
    <!--
      Dark mode FOUC prevention.
      Reads localStorage preference BEFORE paint to avoid flash.
      Runs inline — must not be deferred or async.
    -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('wm-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored === 'dark' || stored === 'light' ? stored : (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <SkipLink />

    <Header />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
