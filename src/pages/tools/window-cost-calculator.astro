    cursor: pointer;
  }

  .feature-input {
    accent-color: var(--color-ink);
    cursor: pointer;
  }

  /* Results Panel */
  .empty-state {
    padding: var(--spacing-3xl) var(--spacing-xl);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .empty-icon-wrap {
