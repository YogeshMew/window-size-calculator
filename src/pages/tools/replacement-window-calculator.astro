---
/**
 * WindowMetrics — Replacement Window Calculator
 * Route: /tools/replacement-window-calculator
 *
 * Flagship decision assistant for replacement windows.
 * Calculates nearest standard factory size match across 5 regions,
 * match percentage score, 5-star rating, rough opening sizing, shim space,
 * cost impact, DIY difficulty, and supplier-ready print summaries.
 */

import ToolLayout from '@/layouts/ToolLayout.astro';
import InputCard from '@/components/calculator/InputCard.astro';
import UnitSelector from '@/components/calculator/UnitSelector.astro';
import ResultCard from '@/components/calculator/ResultCard.astro';
import ResultMetricCard from '@/components/calculator/ResultMetricCard.astro';
import EmptyState from '@/components/calculator/EmptyState.astro';
import WarningBanner from '@/components/calculator/WarningBanner.astro';
import RelatedTools from '@/components/calculator/RelatedTools.astro';
import FAQSection from '@/components/content/FAQSection.astro';
import HistoryPanel from '@/components/calculator/HistoryPanel.astro';
import ShareExportBar from '@/components/calculator/ShareExportBar.astro';
import CalculatorHero from '@/components/calculator/CalculatorHero.astro';

import { getToolBySlug } from '@/data/tools.js';
import type { BreadcrumbItem, FAQ } from '@/types/calculator.js';

const tool = getToolBySlug('replacement-window-calculator')!;

const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: tool.title, href: tool.href, current: true },
];

const faqs: FAQ[] = [
  {
    question: 'How do I know if I can use a standard size replacement window?',
    answer:
      'If your measured window frame is within 0.5" to 2" of a standard factory size (e.g. 36" × 60" in the US or 900 × 1200 mm in the UK), an off-the-shelf standard window will fit. Installers bridge minor gaps using wood shims and low-expansion window foam.',
  },
  {
    question: 'What is the difference between Insert and Full-Frame replacement?',
    answer:
      'Insert replacement installs a new window inside your existing intact wood frame, preserving interior casing and exterior trim. Full-Frame replacement removes the entire existing frame down to the rough stud opening, ideal if old wood is rotted, water-damaged, or out of square.',
  },
  {
    question: 'How do I calculate rough opening from my frame measurements?',
    answer:
      'Standard rough opening requirement is frame width + 1" (0.5" shim space per side) and frame height + 1" (0.5" shim space top/bottom). For an insert window, shim space is typically 1/4" (6.35 mm) per side.',
  },
  {
    question: 'When is a custom-sized replacement window required?',
    answer:
      'Custom windows are recommended whenever your dimensions are more than 4" away from any standard size, or if modifying the surrounding wall structure (headers, studs, exterior brick) would cost more than a custom window surcharge.',
  },
  {
    question: 'How much more does a custom window cost compared to a standard size?',
    answer:
      'Custom replacement windows typically cost 25% to 50% more than stock standard sizes and require a 3 to 6-week factory lead time. Stock standard sizes are readily available at Home Depot, Lowe’s, or local supply yards.',
  },
  {
    question: 'What measurement should I take if my window frame is out of square?',
    answer:
      'Measure width at top, middle, and bottom. Measure height at left, middle, and right. Use the SMALLEST width and SMALLEST height measurement to ensure the new window unit fits into the opening.',
  },
  {
    question: 'Can I install a replacement window myself (DIY)?',
    answer:
      'Small to medium insert replacements (under 15 sq ft) are accessible DIY projects taking 2–4 hours. Large double-hung, bay, or full-frame exterior replacements require professional crew handling for weatherproofing and structural integrity.',
  },
  {
    question: 'Which standard size database does this calculator use?',
    answer:
      'WindowMetrics integrates regional standard size databases aligned with ANSI/AAMA/WDMA 101 (US), NBC (Canada), BS 6375-1 (UK), AS 2047 (Australia), and EN 14351-1 (Europe).',
  },
];

// Schema.org Structured Data
const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'WindowMetrics Replacement Window Calculator',
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  description: tool.description,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: b.label,
    item: `https://windowmetrics.com${b.href}`,
  })),
};
---

<ToolLayout tool={tool} breadcrumbs={breadcrumbs} faqs={faqs}>
  <script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <CalculatorHero
    tool={tool}
    description="Find nearest standard factory sizes, calculate exact rough openings, compare insert vs. full-frame installation, and print a supplier summary."
    features={[
      'Nearest standard match (US, UK, CA, AU, EU)',
      '5-Star match rating & visual score',
      'Rough opening & shim space specs',
      'Insert vs full-frame guidance',
    ]}
    trustItems={[
      { label: 'AAMA & BS standards' },
      { label: '5 Regions' },
      { label: 'No signup' },
      { label: 'Supplier print summary' },
    ]}
  />

  <!-- ── Dashboard Grid ─────────────────────────────────────────────── -->
  <div class="calc-dashboard">

    <!-- LEFT PANEL — Inputs ──────────────────────────────────────── -->
    <div class="calc-panel calc-panel-inputs">

      <div class="panel-header">
        <span class="panel-label">Window dimensions</span>
        <span class="panel-hint">All units supported</span>
      </div>

      <!-- Unit Selector -->
      <div class="unit-row">
        <span class="unit-row-label">Unit</span>
        <UnitSelector selected="in" id="unit-selector" name="unit" />
      </div>

      <!-- Width -->
      <InputCard label="Width" inputId="input-width" hint="e.g. 36 or 35 1/2" required>
        <input
          type="text"
          id="input-width"
          name="width"
          class="input"
          placeholder="36"
          inputmode="decimal"
          autocomplete="off"
          aria-describedby="input-width-hint"
        />
      </InputCard>

      <!-- Height -->
      <InputCard label="Height" inputId="input-height" hint="e.g. 60 or 59 1/2" required>
        <input
          type="text"
          id="input-height"
          name="height"
          class="input"
          placeholder="60"
          inputmode="decimal"
          autocomplete="off"
          aria-describedby="input-height-hint"
        />
      </InputCard>

      <!-- Error / Warning Banner -->
      <WarningBanner />

      <!-- Section: Profile & Region -->
      <div class="panel-section-header">
        <span class="panel-label">Measurement profile &amp; region</span>
      </div>

      <!-- Measurement Type -->
      <InputCard label="Measurement Taken From" inputId="input-measurement-type">
        <select id="input-measurement-type" class="input-select" name="measurement-type">
          <option value="existing-window" selected>Existing Window Frame</option>
          <option value="rough-opening">Rough Opening (Stud to Stud)</option>
          <option value="frame-size">Exact Window Frame Size</option>
          <option value="glass-only">Glass Only (Estimate Frame)</option>
        </select>
      </InputCard>

      <!-- Region Selector -->
      <InputCard label="Standard Size Region" inputId="region-selector">
        <div class="option-selector" id="region-selector" role="group" aria-label="Standard size region">
          <button type="button" class="option-btn option-btn--wide" aria-pressed="true"  data-value="US">🇺🇸 US</button>
          <button type="button" class="option-btn option-btn--wide" aria-pressed="false" data-value="CA">🇨🇦 Canada</button>
          <button type="button" class="option-btn option-btn--wide" aria-pressed="false" data-value="UK">🇬🇧 UK</button>
          <button type="button" class="option-btn option-btn--wide" aria-pressed="false" data-value="AU">🇦🇺 Australia</button>
          <button type="button" class="option-btn option-btn--wide" aria-pressed="false" data-value="EU">🇪🇺 Europe</button>
        </div>
      </InputCard>

      <!-- Section: Style & Method -->
      <div class="panel-section-header">
        <span class="panel-label">Window style &amp; installation</span>
      </div>

      <!-- Window Type -->
      <InputCard label="Window Style" inputId="input-window-type">
        <select id="input-window-type" class="input-select" name="window-type">
          <option value="double-hung" selected>Double Hung</option>
          <option value="single-hung">Single Hung</option>
          <option value="casement">Casement</option>
          <option value="sliding">Sliding / Slider</option>
          <option value="awning">Awning</option>
          <option value="picture">Picture / Fixed</option>
          <option value="bay">Bay Window</option>
          <option value="bow">Bow Window</option>
          <option value="custom">Custom Specialty Shape</option>
        </select>
      </InputCard>

      <!-- Installation Type -->
      <InputCard label="Installation Method" inputId="installation-selector">
        <div class="option-selector" id="installation-selector" role="group" aria-label="Installation method">
          <button type="button" class="option-btn option-btn--wide" aria-pressed="true"  data-value="insert">Insert Replacement</button>
          <button type="button" class="option-btn option-btn--wide" aria-pressed="false" data-value="full-frame">Full Frame Replacement</button>
          <button type="button" class="option-btn option-btn--wide" aria-pressed="false" data-value="new-construction">New Construction</button>
        </div>
      </InputCard>

    </div>

    <!-- RIGHT PANEL — Results ────────────────────────────────── -->
    <div class="calc-panel calc-panel-results" aria-label="Calculation results" aria-live="polite">

      <div class="panel-header">
        <span class="panel-label">Results</span>
        <span class="panel-hint" id="results-unit-display">—</span>
      </div>

      <EmptyState
        title="Enter window dimensions"
        sub="Fill in Width and Height to match standard factory sizes, calculate rough openings, and view installation specs."
        icon="ruler"
      />

      <div id="results-grid" hidden class="results-grid-container">

        <!-- Primary Metric Cards (Priority 7 Hierarchy: Nearest Standard, Confidence, Match Score, Custom Required) -->
        <div class="results-secondary-row">
          <ResultMetricCard
            id="result-standard-size"
            label="Nearest Standard Size"
            value="—"
            unit=""
            sublabel="Standard Factory Size"
            highlight={true}
          />
          <ResultMetricCard
            id="result-confidence"
            label="Replacement Confidence"
            value="—"
            unit=""
            sublabel="Stock vs Custom Assessment"
            highlight={true}
          />
        </div>

        <div class="results-secondary-row">
          <ResultMetricCard
            id="result-match-score"
            label="Match Score & Rating"
            value="—"
            unit=""
            sublabel="Confidence Rating"
            highlight={true}
          />
          <ResultCard
            id="result-custom-required"
            label="Custom Order Required?"
            value="—"
            unit=""
            sublabel="Off-the-shelf fit check"
          />
        </div>

        <!-- Human-Worded Dimensional Differences -->
        <div class="results-secondary-row">
          <ResultCard
            id="result-width-diff"
            label="Width Difference"
            value="—"
            unit=""
            sublabel="Standard vs Measured"
          />
          <ResultCard
            id="result-height-diff"
            label="Height Difference"
            value="—"
            unit=""
            sublabel="Standard vs Measured"
          />
        </div>

        <!-- Top 3 Nearest Standard Sizes (Priority 2) -->
        <div class="alt-sizes-card">
          <div class="alt-sizes-header">Nearest Standard Sizes Comparison</div>
          <div class="top-matches-list" id="top-matches-container">
            <!-- Rendered dynamically by client JS -->
          </div>
        </div>

        <!-- Match Visualization & "Why This Size?" Trust Explanation Card (Priority 11) -->
        <div class="match-vis-card">
          <div class="match-vis-top">
            <span class="match-vis-label">Standard Match Score</span>
            <span class="match-stars" id="match-stars">★★★★★</span>
          </div>
          <div class="match-bar-bg">
            <div class="match-bar-fill" id="match-bar-fill" style="width: 0%;"></div>
          </div>
          <div class="why-this-size-block">
            <span class="why-this-size-title">Why this size?</span>
            <p class="match-trust-text" id="match-trust-text">—</p>
          </div>
        </div>

        <!-- Installation & Rough Opening Specs Card -->
        <div class="install-specs-card">
          <div class="install-specs-header">Installation &amp; Rough Opening Specifications</div>
          <div class="install-grid">
            <div class="install-item">
              <span class="install-val" id="install-ro">—</span>
              <span class="install-key">Recommended Rough Opening</span>
            </div>
            <div class="install-item">
              <span class="install-val" id="install-shim">—</span>
              <span class="install-key">Shim Space (Per Side)</span>
            </div>
            <div class="install-item">
              <span class="install-val" id="install-clearance">—</span>
              <span class="install-key">Total Perimeter Clearance</span>
            </div>
          </div>
          <p class="install-frame-rec" id="install-frame-rec">—</p>
        </div>

        <!-- Guidance Row: Cost Impact | DIY Difficulty -->
        <div class="guidance-row">
          <div class="guidance-card" id="card-cost-impact">
            <div class="guidance-title" id="cost-impact-title">Cost Impact</div>
            <div class="guidance-body"  id="cost-impact-body">—</div>
          </div>
          <div class="guidance-card" id="card-diy">
            <div class="guidance-title" id="diy-title">DIY Installation Rating</div>
            <div class="guidance-body"  id="diy-body">—</div>
          </div>
        </div>

        <!-- SVG Visual Comparison Card -->
        <div class="svg-card">
          <div class="svg-card-label">Visual Size Comparison (Your Window vs. Nearest Standard)</div>
          <svg id="comparison-svg" viewBox="0 0 400 240" aria-label="Visual size comparison diagram">
            <!-- Rendered dynamically by client JS -->
          </svg>
        </div>

        <!-- Smart Recommendation Cards List -->
        <div class="rec-section">
          <div class="rec-section-header">
            <span class="rec-section-title">Smart Replacement Recommendations</span>
          </div>
          <div class="rec-cards-list" id="replacement-rec-list">
            <!-- Dynamically populated by JS -->
          </div>
        </div>

      </div>

    </div>

  </div>

  <!-- ── Extras: Share / Export & History ──────────────────────────── -->
  <div class="calc-extras">
    <ShareExportBar calculatorTitle="Replacement Window Calculator" />
    <HistoryPanel slug="replacement-window-calculator" />
  </div>

  <!-- ── Sidebar Related Tools ──────────────────────────────────────── -->
  <RelatedTools
    slot="sidebar"
    heading="Related calculators"
    links={[
      {
        title: 'Window Size Calculator',
        description: 'Calculate overall window area, perimeter, and general measurements.',
        href: '/tools/window-size-calculator',
        icon: 'Ruler',
      },
      {
        title: 'Window Glass Calculator',
        description: 'Calculate glass pane weight, area, and custom order quantities.',
        href: '/tools/window-glass-calculator',
        icon: 'PanelTop',
      },
      {
        title: 'Curtain Size Calculator',
        description: 'Find curtain width, drop length, and rod size for your new window.',
        href: '/tools/curtain-size-calculator',
        icon: 'Blinds',
      },
      {
        title: 'Window AC Calculator',
        description: 'Verify if your window opening fits standard window air conditioner units.',
        href: '/tools/window-ac-calculator',
        icon: 'AirVent',
      },
    ]}
    tip={{
      label: 'Supplier Tip',
      text: 'Always present net frame dimensions and rough opening measurements when placing window orders at Home Depot or Lowe’s.',
    }}
  />

</ToolLayout>

<script>
  import {
    normalizeInput,
    toMm,
    fromMm,
    formatDimension,
    formatStandardSize,
    calculateReplacementWindow,
    buildReplacementRecommendations,
  } from '@/engine';

  import type {
    MeasurementUnit,
    StandardRegion,
    ReplacementMeasurementType,
    WindowType,
    ReplacementInstallationType,
    DetailedReplacementInput,
    ReplacementCalculationResult,
  } from '@/types/calculator.js';

  import { track } from '@/lib/analytics.js';
  import { historyAdd } from '@/lib/history.js';
  import { readUrlState, pushUrlState, buildShareUrl } from '@/lib/url-state.js';
  import { recordVisit } from '@/lib/recent.js';
  import { buildSummary } from '@/lib/share.js';
  import { buildExportPayload } from '@/lib/export.js';

  // ── Record Visit ─────────────────────────────────────────────────────────
  recordVisit('replacement-window-calculator');

  // ── DOM References ───────────────────────────────────────────────────────

  const widthInput            = document.getElementById('input-width') as HTMLInputElement | null;
  const heightInput           = document.getElementById('input-height') as HTMLInputElement | null;
  const measurementTypeSelect = document.getElementById('input-measurement-type') as HTMLSelectElement | null;
  const windowTypeSelect      = document.getElementById('input-window-type') as HTMLSelectElement | null;

  const resultsGrid           = document.getElementById('results-grid');
  const resultsEmpty          = document.getElementById('results-empty');
  const unitDisplay           = document.getElementById('results-unit-display');

  // Result cards
  const elStandardSize        = document.getElementById('result-standard-size');
  const elMatchScore          = document.getElementById('result-match-score');
  const elConfidence          = document.getElementById('result-confidence');
  const elWidthDiff           = document.getElementById('result-width-diff');
  const elHeightDiff          = document.getElementById('result-height-diff');
  const elCustomRequired      = document.getElementById('result-custom-required');
  const elDistance            = document.getElementById('result-distance');
  const elTopMatchesContainer = document.getElementById('top-matches-container');

  // Match Vis
  const elMatchStars          = document.getElementById('match-stars');
  const elMatchBarFill        = document.getElementById('match-bar-fill');
  const elMatchTrustText      = document.getElementById('match-trust-text');

  // Installation Specs
  const elInstallRo           = document.getElementById('install-ro');
  const elInstallShim         = document.getElementById('install-shim');
  const elInstallClearance    = document.getElementById('install-clearance');
  const elInstallFrameRec     = document.getElementById('install-frame-rec');

  // Guidance Cards
  const elCostTitle           = document.getElementById('cost-impact-title');
  const elCostBody            = document.getElementById('cost-impact-body');
  const elDiyTitle            = document.getElementById('diy-title');
  const elDiyBody             = document.getElementById('diy-body');

  // SVG & Rec list
  const svgEl                 = document.getElementById('comparison-svg');
  const recListEl             = document.getElementById('replacement-rec-list');

  // State
  let currentUnit: MeasurementUnit                 = 'in';
  let currentRegion: StandardRegion                = 'US';
  let currentInstallation: ReplacementInstallationType = 'insert';

  // ── Input Restoration from URL ───────────────────────────────────────────

  const urlParams = readUrlState();
  if (urlParams) {
    if (urlParams.unit && ['mm', 'cm', 'm', 'in', 'ft'].includes(urlParams.unit)) {
      currentUnit = urlParams.unit as MeasurementUnit;
    }
    if (urlParams.width && widthInput) {
      widthInput.value = String(urlParams.width);
    }
    if (urlParams.height && heightInput) {
      heightInput.value = String(urlParams.height);
    }
  }

  // ── Calculation Routine ──────────────────────────────────────────────────

  function calculate() {
    const rawW = widthInput?.value.trim()  ?? '';
    const rawH = heightInput?.value.trim() ?? '';

    const parsedW = normalizeInput(rawW, currentUnit);
    const parsedH = normalizeInput(rawH, currentUnit);

    // Show empty state if incomplete
    if (parsedW === null || parsedH === null || parsedW <= 0 || parsedH <= 0) {
      resultsGrid?.setAttribute('hidden', '');
      resultsEmpty?.removeAttribute('hidden');
      if (unitDisplay) unitDisplay.textContent = '—';
      (window as any).wmShareExportBar?.hide();
      return;
    }

    const inputData: DetailedReplacementInput = {
      width: parsedW,
      height: parsedH,
      unit: currentUnit,
      region: currentRegion,
      measurementType: (measurementTypeSelect?.value as ReplacementMeasurementType) ?? 'existing-window',
      windowType: (windowTypeSelect?.value as WindowType) ?? 'double-hung',
      installationType: currentInstallation,
    };

    // Execute pure math engine
    const result = calculateReplacementWindow(inputData);

    // Build decoupled UI recommendations
    const recs = buildReplacementRecommendations(result);

    // Reveal results panel
    resultsEmpty?.setAttribute('hidden', '');
    resultsGrid?.removeAttribute('hidden');
    if (unitDisplay) unitDisplay.textContent = currentUnit.toUpperCase();

    const stdSizeFormatted = formatStandardSize(result.standardMatch.nearest, currentUnit, currentRegion);

    // Update Result Cards (Priority 7 Hierarchy & Priority 3/5 Confidence Alignment)
    updateCard(elStandardSize, stdSizeFormatted, `${currentRegion} Standard Size`);
    updateCard(elConfidence, `${recs.statusEmoji} ${recs.starText}`, result.requiresCustomOrder ? 'Custom Order Required' : 'Standard Factory Fit');
    updateCard(elMatchScore, `${result.matchPercentage}%`, recs.starRating);
    updateCard(elCustomRequired, result.requiresCustomOrder ? 'Yes (Custom)' : 'No (Standard)', result.requiresCustomOrder ? 'Custom order required' : 'Stock unit fits');

    // Human-Worded Dimensional Differences (Priority 4)
    const absW = Math.abs(result.standardMatch.diffWidthIn);
    const absH = Math.abs(result.standardMatch.diffHeightIn);

    const wDiffPhrase = result.standardMatch.diffWidthIn > 0 
      ? `Standard is ${absW.toFixed(1)}" wider`
      : result.standardMatch.diffWidthIn < 0 
      ? `Standard is ${absW.toFixed(1)}" narrower` 
      : 'Identical width';

    const hDiffPhrase = result.standardMatch.diffHeightIn > 0 
      ? `Standard is ${absH.toFixed(1)}" taller` 
      : result.standardMatch.diffHeightIn < 0 
      ? `Standard is ${absH.toFixed(1)}" shorter` 
      : 'Identical height';

    updateCard(elWidthDiff, wDiffPhrase, 'Width Delta');
    updateCard(elHeightDiff, hDiffPhrase, 'Height Delta');
    updateCard(elDistance, `${result.distanceIn.toFixed(1)}"`, 'Euclidean Delta');

    // Render Top 3 Alternative Standard Sizes (Priority 2)
    if (elTopMatchesContainer) {
      elTopMatchesContainer.innerHTML = result.topMatches.map((m, idx) => {
        const score = Math.max(0, Math.min(100, Math.round(100 * (1 - m.distanceIn / 12))));
        const isBest = idx === 0;
        const candidateStr = formatStandardSize(m.nearest, currentUnit, currentRegion);
        return `
          <div class="alt-size-row ${isBest ? 'alt-size-row--best' : ''}">
            <div class="alt-size-left">
              <span class="alt-size-badge">${isBest ? '⭐ Best Match' : `#${idx + 1}`}</span>
              <span class="alt-size-dim">${candidateStr}</span>
              <span class="alt-size-type">${m.nearest.type || 'Standard'}</span>
            </div>
            <div class="alt-size-right">
              <span class="alt-size-score">${score}% Match</span>
              <span class="alt-size-dist">(${m.distanceIn.toFixed(1)}" delta)</span>
            </div>
          </div>
        `;
      }).join('');
    }

    // Update Match Vis & Why This Size (Priority 11)
    if (elMatchStars) elMatchStars.textContent = `${recs.starRating} (${result.matchPercentage}%)`;
    if (elMatchBarFill) elMatchBarFill.style.width = `${result.matchPercentage}%`;
    if (elMatchTrustText) elMatchTrustText.textContent = recs.whyThisSize;

    // Update Installation Specs
    const roWDisplay = formatDimension(result.roughOpeningWidthMm, currentUnit);
    const roHDisplay = formatDimension(result.roughOpeningHeightMm, currentUnit);
    const shimDisplay = formatDimension(result.shimSpaceMm, currentUnit);
    const clearDisplay = formatDimension(result.clearanceMm, currentUnit);

    if (elInstallRo) elInstallRo.textContent = `${roWDisplay} × ${roHDisplay}`;
    if (elInstallShim) elInstallShim.textContent = `${shimDisplay} / side`;
    if (elInstallClearance) elInstallClearance.textContent = `${clearDisplay} total`;
    if (elInstallFrameRec) elInstallFrameRec.textContent = recs.frameRecommendation;

    // Update Guidance Cards
    if (elCostTitle) elCostTitle.textContent = recs.costImpactTitle;
    if (elCostBody)  elCostBody.textContent  = recs.costImpactNote;
    if (elDiyTitle)  elDiyTitle.textContent  = recs.diyTitle;
    if (elDiyBody)   elDiyBody.textContent   = recs.diyNote;

    // Render SVG Comparison (Priority 6)
    renderSVGComparison(result);

    // Render Recommendations List (Priority 10)
    renderRecommendationCards(recs.cards);

    // Save to History & push URL State (Priority 8)
    (window as any).wmHistoryPanel?.add(
      `${parsedW} × ${parsedH} ${currentUnit}`,
      {
        width: String(parsedW),
        height: String(parsedH),
        unit: currentUnit,
        region: currentRegion,
        installation: currentInstallation,
        nearestStandard: stdSizeFormatted,
        confidence: recs.starText,
      },
    );

    pushUrlState({
      width: String(parsedW),
      height: String(parsedH),
      unit: currentUnit,
      region: currentRegion,
      installation: currentInstallation,
    });

    // Share & Export payload (Priority 9)
    const exportState: Record<string, string> = {
      width: String(parsedW),
      height: String(parsedH),
      unit: currentUnit,
      region: currentRegion,
      installationType: currentInstallation,
      measurementType: inputData.measurementType,
      windowType: inputData.windowType,
    };

    const altSizesSummary = result.topMatches.map(m => {
      const score = Math.max(0, Math.min(100, Math.round(100 * (1 - m.distanceIn / 12))));
      const cStr = formatStandardSize(m.nearest, currentUnit, currentRegion);
      return `${cStr} (${score}%)`;
    }).join(', ');

    (window as any).wmShareExportBar?.show();
    (window as any).wmCurrentState = exportState;
    (window as any).wmBuildSummary = () => buildSummary(
      'Replacement Window Summary & Supplier Specs',
      [
        ['Measured Dimensions', `${parsedW} × ${parsedH} ${currentUnit}`],
        ['Measurement Profile', measurementTypeSelect?.options[measurementTypeSelect.selectedIndex]?.text ?? ''],
        ['Region',              currentRegion],
        ['Nearest Standard Size', stdSizeFormatted],
        ['Alternative Sizes',   altSizesSummary],
        ['Match Score',         `${result.matchPercentage}% (${recs.starRating})`],
        ['Replacement Confidence', `${recs.statusEmoji} ${recs.starText}`],
        ['Custom Required?',    result.requiresCustomOrder ? 'Yes' : 'No'],
        ['Recommended Rough Opening', `${roWDisplay} × ${roHDisplay}`],
        ['Shim Space',          `${shimDisplay} per side`],
        ['Installation Method', currentInstallation],
        ['Cost Impact',         recs.costImpactTitle],
        ['DIY Difficulty',      recs.diyTitle],
      ],
      buildShareUrl(exportState),
    );

    (window as any).wmBuildExport = () => buildExportPayload(
      'replacement-window-calculator',
      exportState,
      {
        nearestStandard: stdSizeFormatted,
        topMatches: result.topMatches.map(m => formatStandardSize(m.nearest, currentUnit, currentRegion)).join(', '),
        matchPercentage: result.matchPercentage,
        confidence: recs.starText,
        requiresCustomOrder: result.requiresCustomOrder ? 'Yes' : 'No',
        roughOpeningWidthMm: result.roughOpeningWidthMm,
        shimSpaceMm: result.shimSpaceMm,
      },
    );

    // Track Analytics
    track({
      type: 'calculation_completed',
      properties: {
        slug: 'replacement-window-calculator',
        unit: currentUnit,
        inputs: exportState,
      },
    });
  }

  // ── Helper: Update Result Card Text ──────────────────────────────────────

  function updateCard(container: HTMLElement | null, val: string, sub?: string) {
    if (!container) return;
    const vEl = container.querySelector('.result-value-text');
    const sEl = container.querySelector('.rmc-sublabel, .result-card-sublabel');
    if (vEl) vEl.textContent = val;
    if (sEl && sub !== undefined) sEl.textContent = sub;
  }

  // ── Helper: Render Interactive SVG Comparison ────────────────────────────

  function renderSVGComparison(res: ReplacementCalculationResult) {
    if (!svgEl) return;

    const stdWidthMm   = res.standardMatch.nearest.widthMm;
    const stdHeightMm  = res.standardMatch.nearest.heightMm;
    const measWidthMm  = res.frameWidthMm;
    const measHeightMm = res.frameHeightMm;

    const formattedMeasW = formatDimension(measWidthMm, currentUnit);
    const formattedMeasH = formatDimension(measHeightMm, currentUnit);
    const formattedStd   = formatStandardSize(res.standardMatch.nearest, currentUnit, currentRegion);

    const maxW = Math.max(stdWidthMm, measWidthMm, 100);
    const maxH = Math.max(stdHeightMm, measHeightMm, 100);

    // Available drawing box: 340px width x 140px height centered inside 400x240
    const scale = Math.min(320 / maxW, 130 / maxH);

    const mW = Math.max(30, Math.round(measWidthMm * scale));
    const mH = Math.max(30, Math.round(measHeightMm * scale));
    const sW = Math.max(30, Math.round(stdWidthMm * scale));
    const sH = Math.max(30, Math.round(stdHeightMm * scale));

    const mX = Math.round((400 - mW) / 2);
    const mY = Math.round((175 - mH) / 2) + 20;
    const sX = Math.round((400 - sW) / 2);
    const sY = Math.round((175 - sH) / 2) + 20;

    let themeColor = '#10b981'; // Green for Excellent/Good
    let statusLabel = 'EXCELLENT';
    if (res.confidence === 'good') {
      themeColor = '#10b981';
      statusLabel = 'GOOD FIT';
    } else if (res.confidence === 'possible') {
      themeColor = '#f59e0b';
      statusLabel = 'ADAPTATION REQUIRED';
    } else if (res.confidence === 'custom-required') {
      themeColor = '#f43f5e';
      statusLabel = 'CUSTOM REQUIRED';
    }

    // Label positioning with background pills for crisp contrast
    const measLabelY = Math.max(16, mY - 6);
    const stdLabelY  = Math.min(195, sY + sH + 14);

    svgEl.innerHTML = `
      <defs>
        <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M 20 0 L 0 0 0 20" fill="none" stroke="var(--color-hairline)" stroke-width="0.5" opacity="0.4"/>
        </pattern>
      </defs>
      
      <!-- Canvas Background -->
      <rect x="0" y="0" width="400" height="240" fill="var(--color-canvas-soft-2)" rx="8"/>
      <rect x="0" y="0" width="400" height="240" fill="url(#grid)" rx="8"/>

      <!-- Standard Unit Outer Box (Fill + Accent Stroke) -->
      <rect x="${sX}" y="${sY}" width="${sW}" height="${sH}" fill="${themeColor}" fill-opacity="0.12" stroke="${themeColor}" stroke-width="2" rx="3"/>

      <!-- Measured Frame Inner/Outer Opening Box (Dashed Architectural Line) -->
      <rect x="${mX}" y="${mY}" width="${mW}" height="${mH}" fill="none" stroke="var(--color-ink)" stroke-width="2" stroke-dasharray="6 4" rx="2"/>

      <!-- Label 1 Pill: Measured Opening (Top Left) -->
      <g transform="translate(${Math.max(12, mX)}, ${measLabelY})">
        <rect x="0" y="-11" width="190" height="15" fill="var(--color-canvas)" stroke="var(--color-hairline)" stroke-width="1" rx="4"/>
        <text x="6" y="0" font-size="9.5" fill="var(--color-ink)" font-family="var(--font-family-mono)" font-weight="600">Measured: ${formattedMeasW} × ${formattedMeasH}</text>
      </g>

      <!-- Label 2 Pill: Nearest Standard Unit (Bottom Right) -->
      <g transform="translate(${Math.min(200, Math.max(12, sX + sW - 190))}, ${stdLabelY})">
        <rect x="0" y="-11" width="190" height="15" fill="var(--color-canvas)" stroke="${themeColor}" stroke-width="1" rx="4"/>
        <text x="6" y="0" font-size="9.5" fill="${themeColor}" font-family="var(--font-family-mono)" font-weight="700">Standard: ${formattedStd}</text>
      </g>

      <!-- Footer Bar / Legend -->
      <line x1="12" y1="210" x2="388" y2="210" stroke="var(--color-hairline)" stroke-width="1"/>
      <g transform="translate(16, 226)">
        <!-- Legend Item 1: Measured -->
        <line x1="0" y1="-3" x2="14" y2="-3" stroke="var(--color-ink)" stroke-width="2" stroke-dasharray="3 2"/>
        <text x="20" y="0" font-size="9.5" fill="var(--color-body)" font-family="var(--font-family-mono)">Measured</text>

        <!-- Legend Item 2: Standard -->
        <rect x="90" y="-7" width="10" height="8" fill="${themeColor}" fill-opacity="0.3" stroke="${themeColor}" stroke-width="1.5" rx="1"/>
        <text x="106" y="0" font-size="9.5" fill="var(--color-body)" font-family="var(--font-family-mono)">Nearest Standard</text>

        <!-- Legend Item 3: Match Badge -->
        <rect x="250" y="-9" width="120" height="14" fill="${themeColor}" rx="3"/>
        <text x="310" y="1" font-size="9" fill="#ffffff" font-family="var(--font-family-mono)" font-weight="700" text-anchor="middle">${res.matchPercentage}% — ${statusLabel}</text>
      </g>
    `;
  }

  // ── Helper: Render Recommendation Cards ─────────────────────────────────

  function renderRecommendationCards(cards: any[]) {
    if (!recListEl) return;
    recListEl.innerHTML = cards.map((c) => `
      <div class="dyn-rec-card" data-status="${c.status}">
        <div class="dyn-rec-top">
          <span class="dyn-rec-label">${c.title}</span>
          ${c.nextAction ? `<a href="${c.href || '#'}" class="rec-next-link">${c.nextAction}</a>` : ''}
        </div>
        <p class="dyn-rec-body">${c.description}</p>
      </div>
    `).join('');
  }

  // ── Event Listeners & Selectors ──────────────────────────────────────────

  function initOptionSelector(containerId: string, onChange: (val: string) => void) {
    const container = document.getElementById(containerId);
    if (!container) return;
    container.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.option-btn') as HTMLButtonElement | null;
      if (!btn) return;
      container.querySelectorAll('.option-btn').forEach((b) => b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));
      onChange(btn.dataset.value ?? '');
      calculate();
    });
  }

  widthInput?.addEventListener('input', calculate);
  heightInput?.addEventListener('input', calculate);
  measurementTypeSelect?.addEventListener('change', calculate);
  windowTypeSelect?.addEventListener('change', calculate);

  initOptionSelector('region-selector', (v) => { currentRegion = v as StandardRegion; });
  initOptionSelector('installation-selector', (v) => { currentInstallation = v as ReplacementInstallationType; });

  document.getElementById('unit-selector')?.addEventListener('unitchange', (e) => {
    const event = e as CustomEvent<{ unit: MeasurementUnit }>;
    const newUnit = event.detail.unit;
    if (newUnit === currentUnit) return;

    const rawW = widthInput?.value.trim() ?? '';
    const rawH = heightInput?.value.trim() ?? '';

    const parsedW = normalizeInput(rawW, currentUnit);
    const parsedH = normalizeInput(rawH, currentUnit);

    if (parsedW !== null && widthInput) {
      widthInput.value = formatDimension(toMm(parsedW, currentUnit), newUnit);
    }
    if (parsedH !== null && heightInput) {
      heightInput.value = formatDimension(toMm(parsedH, currentUnit), newUnit);
    }

    currentUnit = newUnit;
    calculate();
  });

  // Trigger initial calculation if inputs exist
  if (widthInput?.value || heightInput?.value) calculate();

  // Listen for history restore events from HistoryPanel component
  document.addEventListener('wm:history-restore', (e: Event) => {
    const detail = (e as CustomEvent).detail;
    if (!detail || !detail.inputs) return;

    const inputs = detail.inputs as Record<string, string>;

    if (inputs.width && widthInput) widthInput.value = inputs.width;
    if (inputs.height && heightInput) heightInput.value = inputs.height;

    if (inputs.unit && ['mm', 'cm', 'm', 'in', 'ft'].includes(inputs.unit)) {
      currentUnit = inputs.unit as MeasurementUnit;
      document.querySelectorAll('#unit-selector button').forEach((btn) => {
        const val = btn.getAttribute('data-value');
        btn.setAttribute('aria-pressed', val === currentUnit ? 'true' : 'false');
      });
    }

    if (inputs.region && ['US', 'CA', 'UK', 'AU', 'EU'].includes(inputs.region)) {
      currentRegion = inputs.region as StandardRegion;
      document.querySelectorAll('#region-selector button').forEach((btn) => {
        const val = btn.getAttribute('data-value');
        btn.setAttribute('aria-pressed', val === currentRegion ? 'true' : 'false');
      });
    }

    if (inputs.installation && ['insert', 'full-frame', 'new-construction'].includes(inputs.installation)) {
      currentInstallation = inputs.installation as ReplacementInstallationType;
      document.querySelectorAll('#installation-selector button').forEach((btn) => {
        const val = btn.getAttribute('data-value');
        btn.setAttribute('aria-pressed', val === currentInstallation ? 'true' : 'false');
      });
    }

    calculate();
  });

</script>

