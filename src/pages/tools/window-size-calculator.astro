---
/**
 * WindowMetrics — Window Size Calculator
 * Route: /tools/window-size-calculator
 *
 * Premium dashboard layout:
 * LEFT  — Inputs + measurement guide + tips
 * RIGHT — Live results with contextual explanations + recommendations
 *
 * All JS element IDs preserved exactly for script compatibility.
 */

import ToolLayout from '@/layouts/ToolLayout.astro';
import InputCard from '@/components/calculator/InputCard.astro';
import UnitSelector from '@/components/calculator/UnitSelector.astro';
import ResultCard from '@/components/calculator/ResultCard.astro';
import EmptyState from '@/components/calculator/EmptyState.astro';
import WarningBanner from '@/components/calculator/WarningBanner.astro';
import RecommendationCard from '@/components/calculator/RecommendationCard.astro';
import RelatedTools from '@/components/calculator/RelatedTools.astro';
import FAQSection from '@/components/content/FAQSection.astro';
import ToolIcon from '@/components/ui/ToolIcon.astro';
import TrustStrip from '@/components/ui/TrustStrip.astro';
import HistoryPanel from '@/components/calculator/HistoryPanel.astro';
import ShareExportBar from '@/components/calculator/ShareExportBar.astro';
import FavoriteButton from '@/components/ui/FavoriteButton.astro';

import { getToolBySlug, getRelatedTools } from '@/data/tools.js';
import type { BreadcrumbItem, FAQ } from '@/types/calculator.js';

const tool = getToolBySlug('window-size-calculator')!;
const relatedTools = getRelatedTools('window-size-calculator');

const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: tool.title, href: tool.href, current: true },
];

const faqs: FAQ[] = [
  {
    question: 'How do I measure my window correctly?',
    answer:
      'Measure the width at three points: top, middle, and bottom of the opening. Use the smallest measurement. Do the same for height. This accounts for walls that may not be perfectly square.',
  },
  {
    question: 'What is the difference between window size and rough opening size?',
    answer:
      'The window size refers to the frame dimensions of the manufactured window. The rough opening is the larger hole in the wall that the window sits in — typically 0.5" (13 mm) wider and taller on each side to allow for shimming and leveling.',
  },
  {
    question: 'Should I measure in inches or millimeters?',
    answer:
      'In the US, windows are traditionally measured in inches (e.g. 36" × 48"). In the UK and most other countries, millimeters are standard. This calculator works in any unit — just select your preferred unit and enter your measurements.',
  },
  {
    question: 'What does the window area calculation show?',
    answer:
      'The area calculation shows the total square footage or square meter area of the window opening. This is useful for calculating curtain fabric requirements, window film quantities, glass weight, and energy loss estimates.',
  },
  {
    question: 'What is window perimeter used for?',
    answer:
      'Perimeter is used to calculate the amount of weatherstripping, sealant, or trim material needed around the window. It\'s also used in some thermal performance calculations.',
  },
];
---

<ToolLayout tool={tool} breadcrumbs={breadcrumbs} faqs={faqs}>
  <!-- ── Page Hero ─────────────────────────────────────────────────── -->
  <header class="calc-hero">
    <div class="calc-hero-left">
      <div class="icon-container icon-container-lg">
        <ToolIcon name={tool.icon ?? 'Ruler'} size={22} />
      </div>
      <div>
        <div class="calc-status-badge">
          <span class="calc-status-dot" aria-hidden="true"></span>
          Available
        </div>
        <h1 class="calc-hero-title">{tool.title}</h1>
        <p class="calc-hero-desc">
          Enter your window dimensions once. Get area, perimeter, aspect ratio, nearest standard
          size, curtain recommendations, and glass estimates — all instantly.
        </p>
        <TrustStrip
          compact
          items={[
            { label: 'Instant results' },
            { label: 'All units' },
            { label: 'No signup' },
            { label: 'Standard size lookup' },
          ]}
          class="calc-trust"
        />
      </div>
    </div>
    <FavoriteButton slug="window-size-calculator" label="Favorite this calculator" />
  </header>

  <!-- ── Dashboard Grid ─────────────────────────────────────────────── -->
  <div class="calc-dashboard">

    <!-- LEFT PANEL — Inputs ──────────────────────────────────────── -->
    <div class="calc-panel calc-panel-inputs">

      <!-- Panel header -->
      <div class="panel-header">
        <span class="panel-label">Dimensions</span>
        <span class="panel-hint">All units supported</span>
      </div>

      <!-- Unit selector -->
      <div class="unit-row">
        <span class="unit-row-label">Unit</span>
        <UnitSelector selected="in" id="unit-selector" name="unit" />
      </div>

      <!-- Width -->
      <InputCard label="Width" inputId="input-width" hint="e.g. 36 or 36 1/2" required>
        <input
          type="text"
          id="input-width"
          name="width"
          class="input"
          placeholder="36"
          inputmode="decimal"
          autocomplete="off"
          aria-describedby="input-width-hint"
        />
      </InputCard>

      <!-- Height -->
      <InputCard label="Height" inputId="input-height" hint="e.g. 48 or 48 1/2" required>
        <input
          type="text"
          id="input-height"
          name="height"
          class="input"
          placeholder="48"
          inputmode="decimal"
          autocomplete="off"
          aria-describedby="input-height-hint"
        />
      </InputCard>

      <!-- Error / warning banner -->
      <WarningBanner />

      <!-- Measurement guide -->
      <div class="measure-guide">
        <p class="measure-guide-title">How to measure</p>
        <ol class="measure-guide-steps">
          <li>Measure width at top, middle, and bottom — use the <strong>smallest</strong></li>
          <li>Measure height at left, centre, and right — use the <strong>smallest</strong></li>
          <li>Record the frame dimensions, not the glass</li>
        </ol>

        <!-- Mini window illustration -->
        <svg
          class="measure-svg"
          viewBox="0 0 160 120"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <!-- Frame -->
          <rect x="20" y="10" width="120" height="96" rx="3" class="ms-frame" stroke-width="2"/>
          <!-- Dividers -->
          <line x1="20" y1="58" x2="140" y2="58" class="ms-divider" stroke-width="1.5"/>
          <line x1="80" y1="10" x2="80" y2="106" class="ms-divider" stroke-width="1.5"/>
          <!-- Panes -->
          <rect x="22" y="12" width="56" height="44" rx="1" class="ms-pane"/>
          <rect x="82" y="12" width="56" height="44" rx="1" class="ms-pane"/>
          <rect x="22" y="60" width="56" height="44" rx="1" class="ms-pane"/>
          <rect x="82" y="60" width="56" height="44" rx="1" class="ms-pane"/>
          <!-- Width arrow -->
          <line x1="20" y1="112" x2="140" y2="112" class="ms-dimline" marker-start="url(#ms-arr-s)" marker-end="url(#ms-arr-e)"/>
          <text x="80" y="120" class="ms-dimlabel" text-anchor="middle">Width</text>
          <!-- Height arrow -->
          <line x1="148" y1="10" x2="148" y2="106" class="ms-dimline" marker-start="url(#ms-arr-s)" marker-end="url(#ms-arr-e)"/>
          <text x="156" y="62" class="ms-dimlabel" text-anchor="start" dominant-baseline="middle">H</text>
          <defs>
            <marker id="ms-arr-s" markerWidth="5" markerHeight="5" refX="2.5" refY="2.5" orient="auto-start-reverse">
              <path d="M5 0L0 2.5L5 5" fill="none" stroke="currentColor" stroke-width="1.2"/>
            </marker>
            <marker id="ms-arr-e" markerWidth="5" markerHeight="5" refX="2.5" refY="2.5" orient="auto">
              <path d="M0 0L5 2.5L0 5" fill="none" stroke="currentColor" stroke-width="1.2"/>
            </marker>
          </defs>
        </svg>
      </div>
    </div>

    <!-- RIGHT PANEL — Results ────────────────────────────────────── -->
    <div class="calc-panel calc-panel-results" aria-label="Calculation results" aria-live="polite">

      <!-- Panel header -->
      <div class="panel-header">
        <span class="panel-label">Results</span>
        <span class="panel-hint" id="results-unit-display">—</span>
      </div>

      <!-- Empty state -->
      <EmptyState />

      <!-- Results (hidden until calculation) -->
      <div id="results-grid" hidden class="results-grid-container">

        <!-- Primary metric — Area -->
        <ResultCard
          id="result-area"
          label="Window Area"
          value="—"
          unit=""
          highlight
          usedFor={['Glass', 'Film', 'Paint', 'Energy']}
        />

        <!-- Secondary row -->
        <div class="results-secondary-row">
          <ResultCard
            id="result-perimeter"
            label="Perimeter"
            value="—"
            unit=""
            sublabel="For trim and weatherstripping"
          />
          <ResultCard
            id="result-aspect"
            label="Aspect Ratio"
            value="—"
            sublabel="Width to height proportion"
          />
        </div>

        <!-- Reference conversions -->
        <div class="results-reference">
          <p class="reference-label">Reference dimensions</p>
          <div class="reference-grid">
            <div class="reference-item">
              <span class="reference-key">Width</span>
              <span id="result-width-mm" class="reference-value">
                <span class="result-value-text">—</span>
                <span class="result-unit">mm</span>
              </span>
            </div>
            <div class="reference-item">
              <span class="reference-key">Height</span>
              <span id="result-height-mm" class="reference-value">
                <span class="result-value-text">—</span>
                <span class="result-unit">mm</span>
              </span>
            </div>
          </div>
        </div>

        <!-- Contextual recommendations -->
        <div class="results-context">
          <p class="context-label">What these results help you do</p>
          <ul class="context-list">
            <li class="context-item">
              <span class="context-dot"></span>
              <div>
                <strong>Replacement planning</strong> — find a standard window size that matches
                or compare to manufacturer catalogues
              </div>
            </li>
            <li class="context-item">
              <span class="context-dot"></span>
              <div>
                <strong>Curtain sizing</strong> — use width × 1.5–2 for full coverage; add
                height for the drop plus heading
              </div>
            </li>
            <li class="context-item">
              <span class="context-dot"></span>
              <div>
                <strong>Glass estimate</strong> — area gives you the glazing surface; add 10%
                for waste when ordering
              </div>
            </li>
          </ul>
        </div>

        <!-- ── Smart Recommendations ─────────────────────────────── -->
        <div id="rec-section" class="rec-section" hidden>

          <div class="rec-section-header">
            <span class="rec-section-title">Smart recommendations</span>
          </div>

          <!-- Nearest standard size — visual comparison -->
          <RecommendationCard label="Standard size match" badgeId="rec-std-badge" noteId="rec-std-note" noteText="US residential standard (AAMA)">
            <div class="std-comparison">
              <div class="std-comp-row">
                <span class="std-comp-key">Your window</span>
                <span id="rec-your-dims" class="std-comp-val">—</span>
              </div>
              <div class="std-comp-arrow" aria-hidden="true">↓</div>
              <div class="std-comp-row std-comp-row--highlight">
                <span class="std-comp-key">Nearest standard</span>
                <span id="rec-std-dims" class="std-comp-val std-comp-val--std">—</span>
              </div>
              <div class="std-comp-diff" id="rec-std-diff" hidden></div>
            </div>
          </RecommendationCard>

          <!-- Curtain sizing -->
          <RecommendationCard label="Curtain sizing" noteId="rec-curtain-drop" noteText="Drop: —">
            <div class="rec-two-col">
              <div class="rec-col">
                <span class="rec-col-label">Min. width</span>
                <span id="rec-curtain-min" class="rec-col-value">—</span>
              </div>
              <div class="rec-col">
                <span class="rec-col-label">Full coverage</span>
                <span id="rec-curtain-full" class="rec-col-value">—</span>
              </div>
            </div>
          </RecommendationCard>

          <!-- Glass estimate -->
          <RecommendationCard label="Glass estimate" noteText="Single pane, 4 mm glass. Add 10% for cutting waste.">
            <div class="rec-two-col">
              <div class="rec-col">
                <span class="rec-col-label">Glazing area</span>
                <span id="rec-glass-area" class="rec-col-value">—</span>
              </div>
              <div class="rec-col">
                <span class="rec-col-label">Est. weight</span>
                <span id="rec-glass-weight" class="rec-col-value">—</span>
              </div>
            </div>
          </RecommendationCard>

          <!-- Next step -->
          <RecommendationCard label="Suggested next step" variant="next-step">
            <a href="/tools" class="rec-next-link">
              Browse related calculators →
            </a>
          </RecommendationCard>

        </div>
      </div>
    </div>
  </div>

  <!-- ── Share / Export / History ──────────────────────────────────── -->
  <div class="calc-extras">
    <ShareExportBar calculatorTitle={tool.title} />
    <HistoryPanel slug="window-size-calculator" />
  </div>

  <!-- ── FAQ ────────────────────────────────────────────────────────── -->
  <div class="calc-faq">
    <FAQSection faqs={faqs} />
  </div>

  <!-- ── Sidebar: Related tools ─────────────────────────────────────── -->
  <RelatedTools
    slot="sidebar"
    heading="Use your measurements for"
    links={[
      {
        title: 'Window Glass Calculator',
        description: 'Estimate glazing area and glass weight using your current width and height.',
        href: '/tools/window-glass-calculator',
        ariaLabel: 'Window Glass Calculator',
      },
      {
        title: 'Replacement Calculator',
        description: 'Find the closest standard replacement size for your opening dimensions.',
        href: '/tools/replacement-window-calculator',
        ariaLabel: 'Replacement Window Calculator',
      },
      {
        title: 'Curtain Calculator',
        description: 'Instantly size curtains using your measured width and drop height.',
        href: '/tools/curtain-size-calculator',
        ariaLabel: 'Curtain Size Calculator',
      },
      {
        title: 'AC Sizing Calculator',
        description: 'Use your window area to estimate the right BTU rating for cooling.',
        href: '/tools/window-ac-calculator',
        ariaLabel: 'Window AC Calculator',
      },
    ]}
    tip={{
      label: 'Pro tip',
      text: 'Measure at three points and always use the smallest dimension. Walls are rarely perfectly square.',
    }}
    guide={{
      label: 'Related guide',
      href: '/guides',
      text: 'How to measure a window for replacement →',
    }}
  />
</ToolLayout>

<!-- Calculator logic — powered by the WindowMetrics engine -->
<script>
  /**
   * Window Size Calculator — Client Script
   *
   * All calculation logic is delegated to @/engine/*.
   * Formatting and UI state management are provided by @/utils/*.
   *
   * This script is responsible only for:
   * - Reading DOM input
   * - Calling engine functions
   * - Writing formatted results back to the DOM
   */

  import {
    normalizeInput,
    toMm,
    formatArea,
    isMetricUnit,
    validateDimensions,
    calculateArea,
    calculatePerimeter,
    calculateAspectRatio,
    calculateNetGlassArea,
    calculateGlassWeight,
    findNearestStandardSize,
    calculateCurtainRecommendations,
    MAX_DIMENSION_MM,
    formatDifference,
    formatDistance,
    formatWeight,
    formatCeil,
    curtainAllowanceLabel,
  } from '@/engine/index.js';
  import { fmtVal, fmtInput, maxLimitLabel } from '@/utils/display.js';
  import {
    type CalculatorUIRefs,
    setResult,
    setText,
    showCalculatorError,
    showCalculatorWarning,
    clearCalculatorError,
    resetCalculatorEmpty,
  } from '@/utils/calculator-ui.js';
  import type { MeasurementUnit } from '@/types/calculator.js';
  import { readUrlState, pushUrlState, buildShareUrl } from '@/lib/url-state.js';
  import { recordVisit } from '@/lib/recent.js';
  import { track } from '@/lib/analytics.js';
  import { buildSummary } from '@/lib/share.js';
  import { buildExportPayload } from '@/lib/export.js';

  let currentUnit: MeasurementUnit = 'in';

  // Record this calculator visit for the "Recent calculators" feature
  recordVisit('window-size-calculator');

  // ── DOM references ────────────────────────────────────────────────────────
  const widthInput   = document.getElementById('input-width')          as HTMLInputElement;
  const heightInput  = document.getElementById('input-height')         as HTMLInputElement;
  const errorMsg     = document.getElementById('calc-error')           as HTMLElement;
  const resultsEmpty = document.getElementById('results-empty')        as HTMLElement;
  const resultsGrid  = document.getElementById('results-grid')         as HTMLElement;
  const unitDisplay  = document.getElementById('results-unit-display') as HTMLElement;
  const recSection   = document.getElementById('rec-section')          as HTMLElement | null;

  const resultArea      = document.getElementById('result-area');
  const resultPerimeter = document.getElementById('result-perimeter');
  const resultAspect    = document.getElementById('result-aspect');
  const resultWidthMm   = document.getElementById('result-width-mm');
  const resultHeightMm  = document.getElementById('result-height-mm');

  // Shared refs object passed to UI utility helpers
  const refs: CalculatorUIRefs = {
    errorEl:      errorMsg,
    resultsEmpty,
    resultsGrid,
    recSection,
    widthInput,
    heightInput,
  };

  // ── URL state restore ─────────────────────────────────────────────────────
  // Runs once on page load; silently ignored if no query params are present.
  {
    const saved = readUrlState();
    const validUnits = ['mm', 'cm', 'm', 'in', 'ft'];
    const savedUnit = saved.unit as MeasurementUnit;
    if (savedUnit && validUnits.includes(savedUnit)) {
      currentUnit = savedUnit;
      document.querySelectorAll<HTMLButtonElement>('.unit-btn').forEach((b) => {
        b.setAttribute('aria-pressed', b.dataset.unit === savedUnit ? 'true' : 'false');
      });
    }
    if (saved.width && widthInput)   widthInput.value  = saved.width;
    if (saved.height && heightInput) heightInput.value = saved.height;
  }

  // ── History restore listener ──────────────────────────────────────────────
  document.addEventListener('wm:history-restore', (e) => {
    const detail = (e as CustomEvent<{ inputs: Record<string, string>; entryId: string }>).detail;
    const validUnits = ['mm', 'cm', 'm', 'in', 'ft'];
    const savedUnit  = detail.inputs.unit as MeasurementUnit;
    if (savedUnit && validUnits.includes(savedUnit) && savedUnit !== currentUnit) {
      currentUnit = savedUnit;
      document.querySelectorAll<HTMLButtonElement>('.unit-btn').forEach((b) => {
        b.setAttribute('aria-pressed', b.dataset.unit === savedUnit ? 'true' : 'false');
      });
    }
    if (detail.inputs.width  && widthInput)  widthInput.value  = detail.inputs.width;
    if (detail.inputs.height && heightInput) heightInput.value = detail.inputs.height;
    calculate();
    track({ type: 'history_restored', properties: { slug: 'window-size-calculator', entryId: detail.entryId } });
  });

  // ── Keyboard UX ───────────────────────────────────────────────────────────
  // Escape clears the warning/error banner so the user can keep typing
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && errorMsg.textContent) {
      clearCalculatorError(refs);
    }
  });

  // ── Main calculation ──────────────────────────────────────────────────────

  function calculate() {
    const rawWidth  = widthInput?.value.trim()  ?? '';
    const rawHeight = heightInput?.value.trim() ?? '';

    // Reset all error/invalid states on every recalculation
    clearCalculatorError(refs);

    // Empty fields — show neutral placeholder
    if (!rawWidth || !rawHeight) {
      resetCalculatorEmpty(refs);
      resultsEmpty.hidden = false;
      resultsGrid.hidden  = true;
      if (recSection) recSection.hidden = true;
      return;
    }

    // ── 1. Strict parse — whitelist-validated BEFORE any calculation ──────────
    //    normalizeInput rejects "36abc", "1e3", "36-8/3", "-36", etc.
    const parsedWidth  = normalizeInput(rawWidth,  currentUnit);
    const parsedHeight = normalizeInput(rawHeight, currentUnit);

    if (parsedWidth === null) {
      showCalculatorError(
        refs,
        `"${rawWidth}" is not a valid width. Use a number (36), decimal (36.5), or fraction (36 1/2 or 48-3/8).`,
        'width',
      );
      return;
    }
    if (parsedHeight === null) {
      showCalculatorError(
        refs,
        `"${rawHeight}" is not a valid height. Use a number (48), decimal (48.5), or fraction (48 3/8 or 48-7/16).`,
        'height',
      );
      return;
    }

    // ── 2. Convert to mm — all subsequent checks operate only on mm ───────────
    const widthMm  = toMm(parsedWidth,  currentUnit);
    const heightMm = toMm(parsedHeight, currentUnit);
    const widthIn  = widthMm  / 25.4;
    const heightIn = heightMm / 25.4;

    // ── 3. Hard limit check with unit-specific message ────────────────────────
    //    (mirrors the engine's MAX_DIMENSION_MM; done here so the message
    //     names the limit in the user's active unit, not always "30 feet")
    if (widthMm > MAX_DIMENSION_MM) {
      showCalculatorError(
        refs,
        `Width is too large — maximum supported is ${maxLimitLabel(MAX_DIMENSION_MM, currentUnit)}.`,
        'width',
      );
      return;
    }
    if (heightMm > MAX_DIMENSION_MM) {
      showCalculatorError(
        refs,
        `Height is too large — maximum supported is ${maxLimitLabel(MAX_DIMENSION_MM, currentUnit)}.`,
        'height',
      );
      return;
    }

    // ── 4. Soft advisory warnings (non-blocking — calculations continue) ──────
    if (widthIn > 120) {
      showCalculatorWarning(refs, 'This width is larger than most residential windows. Double-check your measurement or unit selection.');
    } else if (heightIn > 120) {
      showCalculatorWarning(refs, 'This height is larger than most residential windows. Double-check your measurement or unit selection.');
    } else if (widthIn < 6 && widthMm >= 25) {
      showCalculatorWarning(refs, 'This width is smaller than a typical window pane. Are you measuring in the right unit?');
    }

    // ── 5. Engine validation (NaN, ≤0, below min, unusual aspect ratio) ──────
    const validation = validateDimensions({ widthMm, heightMm });
    if (!validation.valid) {
      if (validation.level === 'warning') {
        showCalculatorWarning(refs, validation.message ?? 'Unusual window proportions — double-check measurements.');
      } else {
        showCalculatorError(
          refs,
          validation.message ?? 'Invalid dimensions.',
          validation.field === 'width'  ? 'width'
          : validation.field === 'height' ? 'height'
          : undefined,
        );
        return;
      }
    }

    const dims = { widthMm, heightMm };

    // ── 6. Core calculations ──────────────────────────────────────────────────
    const areaMm2     = calculateArea(dims);
    const perimeterMm = calculatePerimeter(dims);
    const aspectRatio = calculateAspectRatio(dims);
    const metric      = isMetricUnit(currentUnit);

    const areaUnit = currentUnit === 'in' ? 'sq in'
                   : currentUnit === 'ft' ? 'sq ft'
                   : `${currentUnit}\u00b2`;

    const dimUnit = currentUnit === 'in' ? '"'
                  : currentUnit === 'ft' ? "'"
                  : currentUnit;

    setResult(resultArea,      formatArea(areaMm2, currentUnit).split(' ')[0], areaUnit);
    setResult(resultPerimeter, fmtVal(perimeterMm, currentUnit), dimUnit);
    setResult(resultAspect,    aspectRatio, '');
    setResult(resultWidthMm,  fmtVal(widthMm,  currentUnit), dimUnit);
    setResult(resultHeightMm, fmtVal(heightMm, currentUnit), dimUnit);

    if (unitDisplay) {
      unitDisplay.textContent = `${fmtVal(widthMm, currentUnit)} \u00d7 ${fmtVal(heightMm, currentUnit)} ${currentUnit}`;
    }

    // ── 7. Smart recommendations ──────────────────────────────────────────────

    // 7a. Standard size match
    const std    = findNearestStandardSize(widthMm, heightMm, 'US');
    const stdWmm = toMm(std.nearest.widthIn,  'in');
    const stdHmm = toMm(std.nearest.heightIn, 'in');

    setText('rec-your-dims',
      metric
        ? `${fmtVal(widthMm, currentUnit)} \u00d7 ${fmtVal(heightMm, currentUnit)} ${currentUnit}`
        : `${widthIn.toFixed(1)}" \u00d7 ${heightIn.toFixed(1)}"`);

    setText('rec-std-dims',
      metric
        ? `${fmtVal(stdWmm, currentUnit)} \u00d7 ${fmtVal(stdHmm, currentUnit)} ${currentUnit}`
        : `${std.nearest.widthIn}" \u00d7 ${std.nearest.heightIn}"`);

    const diffEl = document.getElementById('rec-std-diff') as HTMLElement | null;
    if (diffEl) {
      if (!std.isExact) {
        diffEl.textContent = `Diff: ${formatDifference(std.diffWidthIn, currentUnit)} width \u00b7 ${formatDifference(std.diffHeightIn, currentUnit)} height`;
        diffEl.hidden = false;
      } else {
        diffEl.hidden = true;
      }
    }

    const stdBadge  = document.getElementById('rec-std-badge');
    const stdNoteEl = document.getElementById('rec-std-note');

    if (stdBadge) {
      if (std.isExact) {
        stdBadge.textContent  = 'Exact match';
        stdBadge.dataset.type = 'exact';
      } else if (std.isClose) {
        stdBadge.textContent  = `\u00b1${formatDistance(std.distanceIn, currentUnit)} close`;
        stdBadge.dataset.type = 'close';
      } else {
        stdBadge.textContent  = `${formatDistance(std.distanceIn, currentUnit)} away`;
        stdBadge.dataset.type = 'far';
      }
    }

    if (stdNoteEl) {
      stdNoteEl.textContent = std.isExact
        ? 'Your window matches a US standard size exactly.'
        : std.isClose
        ? 'Very close to a standard — may be a nominal measurement.'
        : 'Custom size. Replacement will likely require a special order.';
    }

    // 7b. Curtain sizing — all values in current unit
    const curtain = calculateCurtainRecommendations(dims);
    setText('rec-curtain-min',  formatCeil(curtain.minWidthMm,  currentUnit));
    setText('rec-curtain-full', formatCeil(curtain.fullWidthMm, currentUnit));
    setText('rec-curtain-drop',
      `Drop: ${formatCeil(curtain.dropMm, currentUnit)} (incl. ${curtainAllowanceLabel(currentUnit)} above-window allowance)`);

    // 7c. Glass estimate
    const glazingAreaMm2 = calculateNetGlassArea(dims);
    const glass          = calculateGlassWeight(glazingAreaMm2);
    setText('rec-glass-area',   formatArea(glazingAreaMm2, currentUnit));
    setText('rec-glass-weight', formatWeight(glass.totalWeightKg, glass.totalWeightLbs, currentUnit));

    if (recSection) recSection.hidden = false;

    // ── 8. Show results ───────────────────────────────────────────────────────
    resultsEmpty.hidden = true;
    resultsGrid.hidden  = false;

    // ── 9. Phase 5 — URL state, history, share, analytics ────────────────────
    pushUrlState({ width: rawWidth, height: rawHeight, unit: currentUnit });

    const histLabel = `${fmtVal(widthMm, currentUnit)} × ${fmtVal(heightMm, currentUnit)} ${currentUnit}`;
    (window as any).wmHistoryPanel?.add(histLabel, { width: rawWidth, height: rawHeight, unit: currentUnit });
    (window as any).wmShareExportBar?.show();

    // Expose state for Share/Export components
    (window as any).wmCurrentState = { width: rawWidth, height: rawHeight, unit: currentUnit };
    (window as any).wmBuildSummary = () => buildSummary(
      'Window Size Calculator',
      [
        ['Width',        `${fmtVal(widthMm, currentUnit)} ${currentUnit}`],
        ['Height',       `${fmtVal(heightMm, currentUnit)} ${currentUnit}`],
        ['Area',         formatArea(areaMm2, currentUnit)],
        ['Perimeter',    `${fmtVal(perimeterMm, currentUnit)} ${currentUnit}`],
        ['Aspect Ratio', aspectRatio],
      ],
      buildShareUrl({ width: rawWidth, height: rawHeight, unit: currentUnit }),
    );
    (window as any).wmBuildExport = () => buildExportPayload(
      'window-size-calculator',
      { width: rawWidth, height: rawHeight, unit: currentUnit },
      { area: formatArea(areaMm2, currentUnit), perimeter: `${fmtVal(perimeterMm, currentUnit)} ${currentUnit}`, widthMm, heightMm },
    );

    track({
      type: 'calculation_completed',
      properties: { slug: 'window-size-calculator', unit: currentUnit, inputs: { width: rawWidth, height: rawHeight } },
    });

    // Mobile UX: smooth-scroll to results on small screens
    if (window.innerWidth < 768) {
      resultsGrid.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  // ── Event listeners ───────────────────────────────────────────────────────

  widthInput?.addEventListener('input',  calculate);
  heightInput?.addEventListener('input', calculate);

  document.getElementById('unit-selector')?.addEventListener('unitchange', (e) => {
    const event   = e as CustomEvent<{ unit: MeasurementUnit }>;
    const newUnit = event.detail.unit;
    if (newUnit === currentUnit) return;

    // Convert existing field values from the old unit into the new unit.
    // This ensures "48-3/8" in inches becomes "1229 mm" (not "48 mm").
    const rawW = widthInput?.value.trim()  ?? '';
    const rawH = heightInput?.value.trim() ?? '';

    const parsedW = normalizeInput(rawW, currentUnit);
    const parsedH = normalizeInput(rawH, currentUnit);

    if (parsedW !== null && widthInput) {
      widthInput.value = fmtInput(toMm(parsedW, currentUnit), newUnit);
    }
    if (parsedH !== null && heightInput) {
      heightInput.value = fmtInput(toMm(parsedH, currentUnit), newUnit);
    }

    const prevUnit = currentUnit;
    currentUnit = newUnit;
    calculate();

    track({ type: 'unit_changed', properties: { slug: 'window-size-calculator', from: prevUnit, to: newUnit } });
  });

  // Initial calculation from URL state (if inputs were restored)
  if (widthInput?.value || heightInput?.value) calculate();
</script>

