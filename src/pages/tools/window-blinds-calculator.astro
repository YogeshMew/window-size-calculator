    gap: 2px;
  }

  .option-btn {
    flex: 1;
    appearance: none;
    background: transparent;
    border: none;
    padding: var(--spacing-sm);
    font-size: var(--font-size-body-sm);
    font-weight: 500;
    color: var(--color-muted);
    border-radius: calc(var(--radius-md) - 2px);
    cursor: pointer;
    transition: all 0.2s;
  }

  .option-btn:hover {
    color: var(--color-ink);
  }

  .option-btn[aria-pressed="true"] {
    background-color: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-sm);
  }

  .advanced-section {
    padding: var(--spacing-md);
    border-top: 1px solid var(--color-hairline);
  }

  .advanced-section summary {
    font-size: var(--font-size-body-sm);
    font-weight: 500;
    color: var(--color-muted);
    cursor: pointer;
    user-select: none;
  }
  
  .advanced-content {
    margin-top: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  /* ── Remove button styles (live calculator) ────────────────────── */
  /* .panel-actions and .btn-primary are unused — kept for safety */
  .panel-actions { display: none; }

  .results-metric-grid {
