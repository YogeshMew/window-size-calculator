---
/**
 * WindowMetrics — Window Glass Calculator
 * Route: /tools/window-glass-calculator
 *
 * Calculates glass area, weight, handling requirements, and ordering quantities
 * for any shape and glass type. Full Phase 5 platform integration.
 */

import ToolLayout from '@/layouts/ToolLayout.astro';
import InputCard from '@/components/calculator/InputCard.astro';
import UnitSelector from '@/components/calculator/UnitSelector.astro';
import ResultCard from '@/components/calculator/ResultCard.astro';
import EmptyState from '@/components/calculator/EmptyState.astro';
import WarningBanner from '@/components/calculator/WarningBanner.astro';
import RecommendationCard from '@/components/calculator/RecommendationCard.astro';
import RelatedTools from '@/components/calculator/RelatedTools.astro';
import FAQSection from '@/components/content/FAQSection.astro';
import CalculatorHero from '@/components/calculator/CalculatorHero.astro';
import HistoryPanel from '@/components/calculator/HistoryPanel.astro';
import ShareExportBar from '@/components/calculator/ShareExportBar.astro';

import { getToolBySlug } from '@/data/tools.js';

import type { BreadcrumbItem, FAQ } from '@/types/calculator.js';

const tool = getToolBySlug('window-glass-calculator')!;


const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools' },
  { label: tool.title, href: tool.href, current: true },
];

const faqs: FAQ[] = [
  {
    question: 'How is glass weight calculated?',
    answer:
      'Glass weight = area (m²) × thickness (mm) × 2.5 kg/m²/mm. Float glass has a density of 2,500 kg/m³. A 1 m² pane of 6 mm glass weighs 15 kg. For double-pane IGU, add both glass panes plus approximately 2 kg/m² for the spacer and sealant.',
  },
  {
    question: 'What is the difference between annealed and tempered glass?',
    answer:
      'Annealed glass is standard float glass — it can be cut, drilled, and shaped on-site, but it breaks into large, sharp shards. Tempered glass is heat-treated to be 4–5× stronger and must be sized before tempering. When it breaks, it shatters into small, blunt granules that are far safer.',
  },
  {
    question: 'When is tempered glass required?',
    answer:
      'Building codes in most countries require tempered (or laminated) glass near doors, in shower enclosures, for any pane within 500 mm of the floor, skylights, stairwells, and panes larger than 0.5 m². Always check your local building code — requirements vary by region.',
  },
  {
    question: 'Can tempered glass be cut after ordering?',
    answer:
      'No. Tempered glass cannot be cut, drilled, or ground after the tempering process. Any modifications must be made to annealed glass before tempering. Always confirm your exact final dimensions before placing a tempered glass order.',
  },
  {
    question: 'How much waste allowance should I add?',
    answer:
      '10% is the industry standard for most rectangular cuts. For non-rectangular shapes (circles, triangles), add 15–20% as more material is wasted. For precision prefabricated panes where you have exact measurements, 5% may suffice.',
  },
  {
    question: 'What does shipping weight include?',
    answer:
      'Shipping weight in this calculator is the glass weight plus 25% for protective packaging — wooden crating, foam edge protectors, and bubble wrap. The exact packing weight varies by supplier, but 20–30% is a reasonable estimate for quoting freight costs.',
  },
  {
    question: 'How do I measure a circular glass pane?',
    answer:
      'Measure the diameter (the widest measurement across the centre). The radius is half the diameter. Enter the diameter in the Width field and select the Circle shape. The calculator converts to area using π × (d/2)².',
  },
  {
    question: 'What glass thickness do I need for my window?',
    answer:
      'For small windows (under 0.25 m²), 4 mm is sufficient. Standard residential windows (0.5–1.5 m²) typically use 5–6 mm. Large panes (over 2 m²) need 8–10 mm. For structural applications, wind load calculations per ASTM E1300 or EN 16612 should be performed by an engineer.',
  },
];
---

<ToolLayout tool={tool} breadcrumbs={breadcrumbs} faqs={faqs}>

  <!-- ── Page Hero ──────────────────────────────────────────────────── -->
  <CalculatorHero
    tool={tool}
    description="Calculate exact glass area, weight, and glazing requirements for single, double, or triple pane windows — all from your window dimensions."
    features={[
      'Glass area by pane count',
      'Weight estimate by thickness',
      'Double & triple pane support',
      'Waste percentage calculator',
    ]}
    trustItems={[
      { label: 'Industry formulas' },
      { label: 'All units' },
      { label: 'No signup' },
      { label: 'Weight estimates' },
    ]}
  />

  <!-- ── Dashboard Grid ─────────────────────────────────────────── -->
  <div class="calc-dashboard">

    <!-- LEFT PANEL — Inputs ──────────────────────────────────── -->
    <div class="calc-panel calc-panel-inputs">

      <!-- Section: Shape & Dimensions -->
      <div class="panel-header">
        <span class="panel-label">Glass dimensions</span>
        <span class="panel-hint">Frame opening size</span>
      </div>

      <!-- Shape selector -->
      <InputCard label="Shape" inputId="shape-selector">
        <div class="option-selector" id="shape-selector" role="group" aria-label="Glass shape">
          <button type="button" class="option-btn" aria-pressed="true"  data-value="rectangle">Rectangle</button>
          <button type="button" class="option-btn" aria-pressed="false" data-value="square">Square</button>
          <button type="button" class="option-btn" aria-pressed="false" data-value="circle">Circle</button>
          <button type="button" class="option-btn" aria-pressed="false" data-value="half-circle">½ Circle</button>
          <button type="button" class="option-btn" aria-pressed="false" data-value="triangle">Triangle</button>
        </div>
      </InputCard>

      <!-- Unit selector -->
      <div class="unit-row">
        <span class="unit-row-label">Unit</span>
        <UnitSelector selected="in" id="unit-selector" name="unit" />
      </div>

      <!-- Width / Diameter -->
      <InputCard label="Width" inputId="input-width" hint="e.g. 36 or 36 1/4" required>
        <input
          type="text"
          id="input-width"
          name="width"
          class="input"
          placeholder="36"
          inputmode="decimal"
          autocomplete="off"
          aria-describedby="input-width-hint"
        />
      </InputCard>

      <!-- Height (hidden for square, circle, half-circle) -->
      <div id="height-row">
        <InputCard label="Height" inputId="input-height" hint="e.g. 48 or 48 1/2" required>
          <input
            type="text"
            id="input-height"
            name="height"
            class="input"
            placeholder="48"
            inputmode="decimal"
            autocomplete="off"
            aria-describedby="input-height-hint"
          />
        </InputCard>
      </div>

      <!-- Shape hint for non-rectangular shapes -->
      <div id="shape-hint" class="shape-hint" hidden></div>

      <!-- Error / warning banner -->
      <WarningBanner />

      <!-- Section: Glass Specification -->
      <div class="panel-section-header">
        <span class="panel-label">Glass specification</span>
      </div>

      <!-- Glass Type -->
      <InputCard label="Glass Type" inputId="input-glass-type">
        <select id="input-glass-type" class="input-select" name="glassType">
          <option value="annealed" selected>Annealed (Standard Float)</option>
          <option value="tempered">Tempered (Toughened)</option>
          <option value="laminated">Laminated Safety Glass</option>
          <option value="double-pane">Double-Pane IGU</option>
          <option value="triple-pane">Triple-Pane IGU</option>
          <option value="low-e">Low-E Coated</option>
        </select>
      </InputCard>

      <!-- Thickness -->
      <InputCard label="Thickness (per pane)" inputId="thickness-selector">
        <div class="option-selector" id="thickness-selector" role="group" aria-label="Glass thickness">
          <button type="button" class="option-btn" aria-pressed="false" data-value="3">3 mm</button>
          <button type="button" class="option-btn" aria-pressed="false" data-value="4">4 mm</button>
          <button type="button" class="option-btn" aria-pressed="false" data-value="5">5 mm</button>
          <button type="button" class="option-btn" aria-pressed="true"  data-value="6">6 mm</button>
          <button type="button" class="option-btn" aria-pressed="false" data-value="8">8 mm</button>
          <button type="button" class="option-btn" aria-pressed="false" data-value="10">10 mm</button>
          <button type="button" class="option-btn" aria-pressed="false" data-value="12">12 mm</button>
          <button type="button" class="option-btn" aria-pressed="false" data-value="15">15 mm</button>
          <button type="button" class="option-btn" aria-pressed="false" data-value="19">19 mm</button>
        </div>
      </InputCard>

      <!-- Quantity -->
      <InputCard label="Quantity" inputId="input-quantity" hint="number of identical panes">
        <div class="occupants-stepper">
          <button type="button" class="stepper-btn" id="qty-dec" aria-label="Decrease quantity">−</button>
          <input
            type="number"
            id="input-quantity"
            name="quantity"
            class="stepper-input"
            min="1"
            max="500"
            value="1"
            aria-describedby="input-quantity-hint"
          />
          <button type="button" class="stepper-btn" id="qty-inc" aria-label="Increase quantity">+</button>
        </div>
      </InputCard>

      <!-- Section: Order Planning -->
      <div class="panel-section-header">
        <span class="panel-label">Order planning</span>
      </div>

      <!-- Waste Allowance -->
      <InputCard label="Waste Allowance" inputId="waste-selector">
        <div class="option-selector" id="waste-selector" role="group" aria-label="Waste allowance">
          <button type="button" class="option-btn" aria-pressed="false" data-value="0">0%</button>
          <button type="button" class="option-btn" aria-pressed="false" data-value="5">5%</button>
          <button type="button" class="option-btn" aria-pressed="true"  data-value="10">10%</button>
          <button type="button" class="option-btn" aria-pressed="false" data-value="15">15%</button>
          <button type="button" class="option-btn" aria-pressed="false" data-value="20">20%</button>
        </div>
      </InputCard>

      <!-- Section: Optional Details -->
      <div class="panel-section-header">
        <span class="panel-label">Optional details</span>
      </div>

      <!-- Edge Finish -->
      <InputCard label="Edge Finish" inputId="edge-selector">
        <div class="option-selector" id="edge-selector" role="group" aria-label="Edge finish">
          <button type="button" class="option-btn option-btn--wide" aria-pressed="true"  data-value="raw">Raw</button>
          <button type="button" class="option-btn option-btn--wide" aria-pressed="false" data-value="polished">Polished</button>
          <button type="button" class="option-btn option-btn--wide" aria-pressed="false" data-value="beveled">Beveled</button>
        </div>
      </InputCard>

      <!-- Hole Cut-outs -->
      <InputCard label="Hole Cut-outs" inputId="holes-selector">
        <div class="option-selector" id="holes-selector" role="group" aria-label="Number of holes">
          <button type="button" class="option-btn" aria-pressed="true"  data-value="0">None</button>
          <button type="button" class="option-btn" aria-pressed="false" data-value="1">1</button>
          <button type="button" class="option-btn" aria-pressed="false" data-value="2">2</button>
          <button type="button" class="option-btn" aria-pressed="false" data-value="4">4+</button>
        </div>
      </InputCard>

      <!-- Calculate button -->
      <button
        type="button"
        id="btn-calculate"
        class="btn-primary"
        aria-label="Calculate glass weight and area"
      >
        Calculate
      </button>

    </div>

    <!-- RIGHT PANEL — Results ────────────────────────────────── -->
    <div class="calc-panel calc-panel-results" aria-label="Calculation results" aria-live="polite">

      <div class="panel-header">
        <span class="panel-label">Results</span>
        <span class="panel-hint" id="results-unit-display">—</span>
      </div>

      <EmptyState
        title="Enter glass dimensions"
        sub="Fill in Width and Height to see weight, area, and handling requirements"
        icon="ruler"
      />

      <div id="results-grid" hidden class="results-grid-container">

        <!-- Smart Cards Row 1: Area | Weight per piece -->
        <div class="results-secondary-row">
          <ResultCard
            id="result-area"
            label="Area per Piece"
            value="—"
            unit=""
            sublabel="Net glass area"
            highlight
          />
          <ResultCard
            id="result-weight"
            label="Weight per Piece"
            value="—"
            unit="kg"
            sublabel="One pane"
            highlight
          />
        </div>

        <!-- Smart Cards Row 2: Total Weight | Shipping Weight -->
        <div class="results-secondary-row">
          <ResultCard
            id="result-total-weight"
            label="Total Weight"
            value="—"
            unit="kg"
            sublabel="All panes combined"
          />
          <ResultCard
            id="result-shipping"
            label="Shipping Weight"
            value="—"
            unit="kg"
            sublabel="+25% for packaging"
          />
        </div>

        <!-- Handling card (full width) -->
        <div id="handling-card" class="handling-card">
          <div class="handling-icon-row">
            <span id="handling-icon" class="handling-icon" aria-hidden="true">👤</span>
            <div>
              <div class="handling-title" id="handling-title">—</div>
              <div class="handling-note"  id="handling-note">—</div>
            </div>
          </div>
        </div>

        <!-- Smart Cards Row 3: Perimeter | Thickness -->
        <div class="results-secondary-row">
          <ResultCard
            id="result-perimeter"
            label="Perimeter"
            value="—"
            unit=""
            sublabel="Edge length"
          />
          <ResultCard
            id="result-thickness"
            label="Total Unit Thickness"
            value="—"
            unit="mm"
            sublabel="Including IGU gap"
          />
        </div>

        <!-- Order Planning (full width) -->
        <div class="order-card">
          <div class="order-card-label">Order planning</div>
          <div class="order-grid">
            <div class="order-item">
              <span class="order-val" id="result-pieces">—</span>
              <span class="order-key">Pieces to order (with waste)</span>
            </div>
            <div class="order-item">
              <span class="order-val" id="result-total-area">—</span>
              <span class="order-key">Total area (all pieces)</span>
            </div>
            <div class="order-item">
              <span class="order-val" id="result-area-waste">—</span>
              <span class="order-key">Area per piece (with waste)</span>
            </div>
          </div>
        </div>

        <!-- Recommendation badges -->
        <div class="badge-row">
          <div class="badge-item">
            <span class="badge-label">Recommended thickness</span>
            <span class="badge-val" id="badge-rec-thickness">—</span>
          </div>
          <div class="badge-item">
            <span class="badge-label">Installation</span>
            <span class="badge-val" id="badge-install">—</span>
          </div>
          <div class="badge-item">
            <span class="badge-label">Safety class</span>
            <span class="badge-val" id="badge-safety">—</span>
          </div>
          <div class="badge-item">
            <span class="badge-label">Custom fabrication</span>
            <span class="badge-val" id="badge-custom-fab">—</span>
          </div>
        </div>

        <!-- Live SVG Illustration -->
        <div class="svg-card">
          <div class="svg-card-label">Live illustration</div>
          <svg
            id="glass-svg"
            viewBox="0 0 300 260"
            xmlns="http://www.w3.org/2000/svg"
            aria-label="Glass pane illustration"
            role="img"
          >
            <!-- Background -->
            <rect width="300" height="260" class="svg-bg" />

            <!-- Stack shadow panes (shown for quantity > 1) -->
            <g id="svg-stack-group">
              <rect id="svg-stack-4" x="68" y="58" width="164" height="144" rx="2" class="svg-stack-pane" />
              <rect id="svg-stack-3" x="64" y="54" width="164" height="144" rx="2" class="svg-stack-pane" />
              <rect id="svg-stack-2" x="60" y="50" width="164" height="144" rx="2" class="svg-stack-pane" />
            </g>

            <!-- Main glass pane -->
            <rect id="svg-glass-main" x="56" y="46" width="164" height="144" rx="2" class="svg-glass" />
            <!-- Glass reflection highlight -->
            <rect id="svg-glass-shine" x="62" y="52" width="40" height="25" rx="2" class="svg-glass-shine" />

            <!-- Shape-specific overlay: circle -->
            <ellipse id="svg-circle" cx="138" cy="118" rx="72" ry="72" class="svg-shape-overlay" style="display:none;" />
            <!-- Half-circle -->
            <path id="svg-half-circle" d="M 66 118 A 72 72 0 0 1 210 118 Z" class="svg-shape-overlay" style="display:none;" />
            <!-- Triangle -->
            <polygon id="svg-triangle" points="56,190 220,190 56,46" class="svg-shape-overlay" style="display:none;" />

            <!-- Dimension arrows — Width -->
            <line id="svg-w-line" x1="56" y1="215" x2="220" y2="215" class="svg-dim-line" />
            <polygon id="svg-w-arr-l" points="56,215 63,212 63,218" class="svg-dim-arrow" />
            <polygon id="svg-w-arr-r" points="220,215 213,212 213,218" class="svg-dim-arrow" />
            <text id="svg-w-label" x="138" y="228" class="svg-dim-text svg-dim-text--center">Width</text>

            <!-- Dimension arrows — Height -->
            <line id="svg-h-line" x1="240" y1="46" x2="240" y2="190" class="svg-dim-line" />
            <polygon id="svg-h-arr-t" points="240,46 237,53 243,53" class="svg-dim-arrow" />
            <polygon id="svg-h-arr-b" points="240,190 237,183 243,183" class="svg-dim-arrow" />
            <text id="svg-h-label" x="252" y="120" class="svg-dim-text" writing-mode="tb">Height</text>

            <!-- Weight label overlay -->
            <rect id="svg-wt-bg" x="56" y="46" width="80" height="28" rx="3" class="svg-label-bg" />
            <text id="svg-wt-text" x="96" y="62" class="svg-label-text svg-dim-text--center">— kg</text>

            <!-- Area label -->
            <text id="svg-area-text" x="138" y="118" class="svg-area-text svg-dim-text--center">—</text>

            <!-- Stack count label -->
            <text id="svg-qty-label" x="252" y="48" class="svg-qty-text" style="display:none;">×1</text>
          </svg>
        </div>

      </div><!-- /#results-grid -->

    </div>

  </div><!-- /.calc-dashboard -->

  <!-- ── Share + History ────────────────────────────────────────── -->
  <div class="calc-extras">
    <ShareExportBar />
    <HistoryPanel slug="window-glass-calculator" />
  </div>

  <!-- ── Warnings + Recommendations ───────────────────────────── -->
  <section id="rec-section" hidden aria-label="Recommendations and warnings">

    <!-- Warnings -->
    <div id="rec-warnings" class="rec-warnings-list"></div>

    <div class="rec-section-header">
      <h2 class="rec-section-title">Recommendations</h2>
    </div>

    <div id="rec-cards" class="rec-cards-grid"></div>

    <!-- Buying guide -->
    <div id="buying-guide" class="buying-guide" hidden>
      <h3 id="buying-guide-title" class="buying-guide-title">—</h3>
      <p id="buying-guide-desc" class="buying-guide-desc"></p>
      <div class="buying-guide-grid">
        <div class="buying-pros">
          <div class="buying-col-label">Pros</div>
          <ul id="buying-pros-list" class="buying-list"></ul>
        </div>
        <div class="buying-cons">
          <div class="buying-col-label">Cons</div>
          <ul id="buying-cons-list" class="buying-list"></ul>
        </div>
      </div>
      <div class="buying-uses">
        <div class="buying-col-label">Typical uses</div>
        <div id="buying-uses-list" class="buying-uses-chips"></div>
      </div>
      <div class="buying-flags">
        <span id="buying-cuttable" class="buying-flag">—</span>
        <span id="buying-safety"   class="buying-flag">—</span>
      </div>
    </div>

  </section>

  <!-- ── Related Tools ─────────────────────────────────────────── -->
  <RelatedTools
    heading="Related calculators"
    links={[
      {
        title: 'Window Size Calculator',
        description: 'Measure your window opening dimensions before ordering glass.',
        href: '/tools/window-size-calculator',
        icon: 'Ruler',
      },
      {
        title: 'Window AC Calculator',
        description: 'Calculate the BTU cooling capacity your window needs.',
        href: '/tools/window-ac-calculator',
        icon: 'Thermometer',
      },
      {
        title: 'Curtain Size Calculator',
        description: 'Find the right curtain dimensions for your window.',
        href: '/tools/curtain-size-calculator',
        icon: 'Blinds',
      },
    ]}
  />

  <!-- ── FAQ ───────────────────────────────────────────────────── -->
  <FAQSection faqs={faqs} />

</ToolLayout>

<script>
  import {
    normalizeInput,
    toMm,
    fromMm,
    isMetricUnit,
  } from '@/engine/units.js';

  import {
    calculateGlass,
    validateGlassDimension,
    type GlassShape,
    type GlassType,
    type EdgeFinish,
  } from '@/engine/glass.js';

  import type { MeasurementUnit } from '@/types/calculator.js';

  import { readUrlState, pushUrlState, buildShareUrl } from '@/lib/url-state.js';
  import { buildSummary } from '@/lib/share.js';
  import { buildExportPayload } from '@/lib/export.js';
  import { recordVisit } from '@/lib/recent.js';
  import { track } from '@/lib/analytics.js';

  // ── Track visit ───────────────────────────────────────────────────────────
  recordVisit('window-glass-calculator');

  // ── DOM references ────────────────────────────────────────────────────────
  const widthInput    = document.getElementById('input-width')    as HTMLInputElement | null;
  const heightInput   = document.getElementById('input-height')   as HTMLInputElement | null;
  const glassTypeSelect = document.getElementById('input-glass-type') as HTMLSelectElement | null;
  const qtyInput      = document.getElementById('input-quantity') as HTMLInputElement | null;
  const qtyDec        = document.getElementById('qty-dec');
  const qtyInc        = document.getElementById('qty-inc');

  const heightRow     = document.getElementById('height-row');
  const shapeHint     = document.getElementById('shape-hint');

  const resultsEmpty  = document.querySelector<HTMLElement>('.empty-state');
  const resultsGrid   = document.getElementById('results-grid');
  const recSection    = document.getElementById('rec-section');
  const recCards      = document.getElementById('rec-cards');
  const recWarnings   = document.getElementById('rec-warnings');
  const buyingGuide   = document.getElementById('buying-guide');

  const errorEl       = document.querySelector<HTMLElement>('[data-wm-warning]');
  const unitDisplay   = document.getElementById('results-unit-display');

  // ── State ─────────────────────────────────────────────────────────────────
  let currentUnit: MeasurementUnit = 'in';
  let currentShape: GlassShape     = 'rectangle';
  let currentEdge: EdgeFinish      = 'raw';
  let currentWaste                 = 10;
  let currentThickness             = 6;
  let currentHoles                 = 0;

  // ── Helpers ────────────────────────────────────────────────────────────────

  function setEl(id: string, text: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  }

  function setResult(card: Element | null, value: string, unit: string) {
    if (!card) return;
    const valEl  = card.querySelector('[data-result-value]');
    const unitEl = card.querySelector('[data-result-unit]');
    if (valEl)  valEl.textContent  = value;
    if (unitEl) unitEl.textContent = unit;
  }

  function showError(msg: string, field?: string) {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.removeAttribute('hidden');
    errorEl.setAttribute('data-level', 'error');
    if (field) document.getElementById(`input-${field}`)?.setAttribute('aria-invalid', 'true');
  }

  function showWarning(msg: string) {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.removeAttribute('hidden');
    errorEl.setAttribute('data-level', 'warning');
  }

  function clearError() {
    if (!errorEl) return;
    errorEl.textContent = '';
    errorEl.setAttribute('hidden', '');
    errorEl.removeAttribute('data-level');
    widthInput?.removeAttribute('aria-invalid');
    heightInput?.removeAttribute('aria-invalid');
  }

  function fmtArea(m2: number, sqft: number): string {
    if (isMetricUnit(currentUnit)) {
      return m2 >= 1 ? `${m2.toFixed(3)} m²` : `${(m2 * 10000).toFixed(0)} cm²`;
    }
    return `${sqft.toFixed(2)} sq ft`;
  }

  function fmtLen(mm: number): string {
    const val = fromMm(mm, currentUnit);
    if (currentUnit === 'mm') return `${Math.round(val)} mm`;
    if (currentUnit === 'cm') return `${val.toFixed(1)} cm`;
    if (currentUnit === 'm')  return `${val.toFixed(2)} m`;
    if (currentUnit === 'ft') return `${val.toFixed(2)} ft`;
    return `${val.toFixed(2)}"`;
  }

  function fmtWeight(kg: number): string {
    return `${kg.toFixed(1)} kg (${(kg * 2.20462).toFixed(1)} lb)`;
  }

  // ── Option selector wiring ─────────────────────────────────────────────────

  function wireOptionGroup(id: string, onChange: (val: string) => void) {
    const container = document.getElementById(id);
    if (!container) return;
    container.querySelectorAll<HTMLButtonElement>('.option-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        container.querySelectorAll<HTMLButtonElement>('.option-btn').forEach((b) => b.setAttribute('aria-pressed', 'false'));
        btn.setAttribute('aria-pressed', 'true');
        onChange(btn.dataset.value ?? '');
      });
    });
  }

  wireOptionGroup('shape-selector', (val) => {
    currentShape = val as GlassShape;
    const needsHeight = val === 'rectangle' || val === 'triangle';
    if (heightRow) heightRow.hidden = !needsHeight;

    const hints: Record<string, string> = {
      circle:        '🔵 Enter the diameter. Area = π × (d÷2)²',
      'half-circle': '🌓 Enter the diameter of the full circle. Area = half of a full circle.',
      square:        '⬜ Width only. Height = Width. Area = w²',
      triangle:      '📐 Right triangle. Enter the two legs (width and height).',
    };
    if (shapeHint) {
      if (hints[val]) { shapeHint.textContent = hints[val]; shapeHint.hidden = false; }
      else            { shapeHint.hidden = true; }
    }

    // Update width label for circle
    const wLabel = document.querySelector<HTMLElement>('[for="input-width"], label[for="input-width"]')
      ?? document.querySelector<HTMLElement>('.input-card-label');
    calculate();
  });

  wireOptionGroup('thickness-selector', (val) => {
    currentThickness = parseInt(val, 10);
    calculate();
  });

  wireOptionGroup('waste-selector', (val) => {
    currentWaste = parseInt(val, 10);
    calculate();
  });

  wireOptionGroup('edge-selector', (val) => {
    currentEdge = val as EdgeFinish;
    calculate();
  });

  wireOptionGroup('holes-selector', (val) => {
    currentHoles = parseInt(val, 10);
    calculate();
  });

  // ── Quantity stepper ───────────────────────────────────────────────────────
  qtyDec?.addEventListener('click', () => {
    const v = parseInt(qtyInput?.value ?? '1', 10);
    if (v > 1 && qtyInput) { qtyInput.value = String(v - 1); calculate(); }
  });
  qtyInc?.addEventListener('click', () => {
    const v = parseInt(qtyInput?.value ?? '1', 10);
    if (v < 500 && qtyInput) { qtyInput.value = String(v + 1); calculate(); }
  });
  qtyInput?.addEventListener('change', () => calculate());
  qtyInput?.addEventListener('keydown', (e) => {
    const v = parseInt(qtyInput.value ?? '1', 10);
    if (e.key === 'ArrowUp'   && v < 500) { qtyInput.value = String(v + 1); calculate(); }
    if (e.key === 'ArrowDown' && v > 1)   { qtyInput.value = String(v - 1); calculate(); }
  });

  // ── Unit selector ─────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.unit-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const newUnit = btn.dataset.unit as MeasurementUnit;
      if (newUnit === currentUnit) return;
      const oldUnit = currentUnit;
      currentUnit = newUnit;
      track({ type: 'unit_changed', properties: { slug: 'window-glass-calculator', from: oldUnit, to: newUnit } });
      calculate();
    });
  });

  // ── Input listeners ────────────────────────────────────────────────────────
  [widthInput, heightInput].forEach((el) => {
    el?.addEventListener('input', () => calculate());
    el?.addEventListener('keydown', (e) => { if (e.key === 'Enter') calculate(); });
  });

  glassTypeSelect?.addEventListener('change', () => calculate());
  document.getElementById('btn-calculate')?.addEventListener('click', () => calculate());

  // ── Keyboard UX ───────────────────────────────────────────────────────────
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && errorEl?.textContent) clearError();
  });

  // ── URL state restore ─────────────────────────────────────────────────────
  {
    const saved = readUrlState();
    const validUnits: MeasurementUnit[] = ['mm', 'cm', 'm', 'in', 'ft'];
    const savedUnit = saved.unit as MeasurementUnit;

    if (savedUnit && validUnits.includes(savedUnit)) {
      currentUnit = savedUnit;
