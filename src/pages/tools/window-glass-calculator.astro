  // ── History restore listener ──────────────────────────────────────────────
  document.addEventListener('wm:history-restore', (e) => {
    const detail = (e as CustomEvent<{ inputs: Record<string, string>; entryId: string }>).detail;
    const { inputs } = detail;
    const validUnits: MeasurementUnit[] = ['mm', 'cm', 'm', 'in', 'ft'];
    const savedUnit = inputs.unit as MeasurementUnit;

    if (savedUnit && validUnits.includes(savedUnit) && savedUnit !== currentUnit) {
      currentUnit = savedUnit;
      document.querySelectorAll<HTMLButtonElement>('.unit-btn').forEach((b) => {
        b.setAttribute('aria-pressed', b.dataset.unit === savedUnit ? 'true' : 'false');
      });
    }

    if (inputs.width  && widthInput)  widthInput.value  = inputs.width;
    if (inputs.height && heightInput) heightInput.value = inputs.height;
    if (inputs.glassType && glassTypeSelect) glassTypeSelect.value = inputs.glassType;
    if (inputs.qty && qtyInput) qtyInput.value = inputs.qty;

    const restoreGroup = (groupId: string, val: string, stateSetter: (v: string) => void) => {
      if (!val) return;
      stateSetter(val);
      document.querySelectorAll<HTMLButtonElement>(`#${groupId} .option-btn`).forEach((b) => {
        b.setAttribute('aria-pressed', b.dataset.value === val ? 'true' : 'false');
      });
    };

    if (inputs.shape)     { restoreGroup('shape-selector',     inputs.shape,     (v) => { currentShape = v as GlassShape; const nh = v === 'rectangle' || v === 'triangle'; if (heightRow) heightRow.hidden = !nh; }); }
    if (inputs.thickness) { restoreGroup('thickness-selector', inputs.thickness, (v) => { currentThickness = parseInt(v, 10); }); }
    if (inputs.waste)     { restoreGroup('waste-selector',     inputs.waste,     (v) => { currentWaste = parseInt(v, 10); }); }
    if (inputs.edge)      { restoreGroup('edge-selector',      inputs.edge,      (v) => { currentEdge = v as EdgeFinish; }); }
    if (inputs.holes)     { restoreGroup('holes-selector',     inputs.holes,     (v) => { currentHoles = parseInt(v, 10); }); }

    calculate();
    track({ type: 'history_restored', properties: { slug: 'window-glass-calculator', entryId: detail.entryId } });
  });

  // ── SVG updater ───────────────────────────────────────────────────────────

  function updateSVG(params: {
    shape: GlassShape;
    aspectRatio: number;
    quantity: number;
    weightKg: number;
    areaM2: number;
    areaUnit: string;
  }) {
    const { shape, aspectRatio, quantity, weightKg, areaM2, areaUnit } = params;

    // Fixed frame inside SVG
    const PAD = { left: 56, top: 46, right: 56, bottom: 70 };
    const SVG_W = 300, SVG_H = 260;
    const maxW = SVG_W - PAD.left - PAD.right;  // 188
    const maxH = SVG_H - PAD.top  - PAD.bottom; // 144

    // Compute display size respecting aspect ratio
    let displayW: number, displayH: number;
    if (shape === 'square') {
      displayW = displayH = Math.min(maxW, maxH);
    } else if (shape === 'circle' || shape === 'half-circle') {
      displayW = displayH = Math.min(maxW, maxH);
    } else {
      if (aspectRatio > maxW / maxH) {
        displayW = maxW; displayH = maxW / aspectRatio;
      } else {
        displayH = maxH; displayW = maxH * aspectRatio;
      }
    }

    const left  = PAD.left + (maxW - displayW) / 2;
    const top   = PAD.top  + (maxH - displayH) / 2;
    const right = left  + displayW;
    const bottom = top  + displayH;
    const cx    = (left + right) / 2;
    const cy    = (top + bottom) / 2;

    // Main glass rect
    const mainRect = document.getElementById('svg-glass-main');
    if (mainRect) {
      mainRect.setAttribute('x', String(left));
      mainRect.setAttribute('y', String(top));
      mainRect.setAttribute('width', String(displayW));
      mainRect.setAttribute('height', String(displayH));
      mainRect.style.display = (shape === 'circle' || shape === 'half-circle' || shape === 'triangle') ? 'none' : 'block';
    }

    // Shine
    const shine = document.getElementById('svg-glass-shine');
    if (shine) {
      shine.setAttribute('x', String(left + 6));
      shine.setAttribute('y', String(top + 6));
      shine.setAttribute('width', '40');
      shine.setAttribute('height', '22');
    }

    // Circle
    const circleEl = document.getElementById('svg-circle');
    if (circleEl) {
      circleEl.setAttribute('cx', String(cx));
      circleEl.setAttribute('cy', String(cy));
      circleEl.setAttribute('rx', String(displayW / 2));
      circleEl.setAttribute('ry', String(displayH / 2));
      circleEl.style.display = shape === 'circle' ? 'block' : 'none';
    }

    // Half-circle
    const halfCircle = document.getElementById('svg-half-circle');
    if (halfCircle) {
      const r = displayW / 2;
      halfCircle.setAttribute('d', `M ${left} ${cy} A ${r} ${r} 0 0 1 ${right} ${cy} Z`);
      halfCircle.style.display = shape === 'half-circle' ? 'block' : 'none';
    }

    // Triangle
    const triEl = document.getElementById('svg-triangle');
    if (triEl) {
      triEl.setAttribute('points', `${left},${bottom} ${right},${bottom} ${left},${top}`);
      triEl.style.display = shape === 'triangle' ? 'block' : 'none';
    }

    // Dimension arrows — Width
    const wY = bottom + 22;
    document.getElementById('svg-w-line')?.setAttribute('x1', String(left));
    document.getElementById('svg-w-line')?.setAttribute('y1', String(wY));
    document.getElementById('svg-w-line')?.setAttribute('x2', String(right));
    document.getElementById('svg-w-line')?.setAttribute('y2', String(wY));
    document.getElementById('svg-w-arr-l')?.setAttribute('points', `${left},${wY} ${left+7},${wY-3} ${left+7},${wY+3}`);
    document.getElementById('svg-w-arr-r')?.setAttribute('points', `${right},${wY} ${right-7},${wY-3} ${right-7},${wY+3}`);
    const wLabel = document.getElementById('svg-w-label');
    if (wLabel) { wLabel.setAttribute('x', String(cx)); wLabel.setAttribute('y', String(wY + 13)); }

    // Dimension arrows — Height (only for rect/square/triangle)
    const needsH = shape === 'rectangle' || shape === 'square' || shape === 'triangle';
    const hX = right + 22;
    document.getElementById('svg-h-line')?.setAttribute('x1', String(hX));
    document.getElementById('svg-h-line')?.setAttribute('y1', String(top));
    document.getElementById('svg-h-line')?.setAttribute('x2', String(hX));
    document.getElementById('svg-h-line')?.setAttribute('y2', String(bottom));
    document.getElementById('svg-h-arr-t')?.setAttribute('points', `${hX},${top} ${hX-3},${top+7} ${hX+3},${top+7}`);
    document.getElementById('svg-h-arr-b')?.setAttribute('points', `${hX},${bottom} ${hX-3},${bottom-7} ${hX+3},${bottom-7}`);
    const hLabel = document.getElementById('svg-h-label');
    if (hLabel) {
      hLabel.setAttribute('x', String(hX + 10));
      hLabel.setAttribute('y', String(cy));
      hLabel.style.display = needsH ? 'block' : 'none';
    }
    document.getElementById('svg-h-line')!.style.display = needsH ? '' : 'none';
    document.getElementById('svg-h-arr-t')!.style.display = needsH ? '' : 'none';
    document.getElementById('svg-h-arr-b')!.style.display = needsH ? '' : 'none';

    // Stack shadows
    const showStack = quantity > 1;
    const stackIds  = ['svg-stack-2', 'svg-stack-3', 'svg-stack-4'];
    stackIds.forEach((id, i) => {
      const el = document.getElementById(id);
      if (el) {
        const off = (i + 1) * 4;
        el.setAttribute('x', String(left + off));
        el.setAttribute('y', String(top + off));
        el.setAttribute('width', String(displayW));
        el.setAttribute('height', String(displayH));
        el.style.display = (showStack && i < Math.min(quantity - 1, 3)) ? 'block' : 'none';
      }
    });

    // Weight label
    const wtBg = document.getElementById('svg-wt-bg');
    const wtTxt = document.getElementById('svg-wt-text');
    if (wtBg) { wtBg.setAttribute('x', String(left + 4)); wtBg.setAttribute('y', String(top + 4)); }
    if (wtTxt) { wtTxt.setAttribute('x', String(left + 44)); wtTxt.setAttribute('y', String(top + 18)); wtTxt.textContent = `${weightKg.toFixed(1)} kg`; }

    // Area label (centered in shape)
    const areaTxt = document.getElementById('svg-area-text');
    if (areaTxt) {
      areaTxt.setAttribute('x', String(cx));
      areaTxt.setAttribute('y', String(cy + 6));
      areaTxt.textContent = areaUnit;
    }

    // Quantity label
    const qtyLabel = document.getElementById('svg-qty-label');
    if (qtyLabel) {
      qtyLabel.textContent = `×${quantity}`;
      qtyLabel.setAttribute('x', String(right - 2));
      qtyLabel.setAttribute('y', String(top - 2));
      qtyLabel.style.display = showStack ? 'block' : 'none';
    }
  }

  // ── Main calculation ──────────────────────────────────────────────────────

  function calculate() {
    clearError();

    const rawWidth  = widthInput?.value.trim()  ?? '';
    const rawHeight = heightInput?.value.trim() ?? '';
    const needsHeight = currentShape === 'rectangle' || currentShape === 'triangle';

    // Empty required fields
    if (!rawWidth || (needsHeight && !rawHeight)) {
      if (resultsEmpty) resultsEmpty.hidden = false;
      if (resultsGrid)  resultsGrid.hidden  = true;
      if (recSection)   recSection.hidden   = true;
      return;
    }

    // Parse width
    const parsedWidth = normalizeInput(rawWidth, currentUnit);
    if (parsedWidth === null || parsedWidth <= 0) {
      showError(`"${rawWidth}" is not a valid width. Enter a number (36), decimal (36.5), or fraction (36 1/4).`, 'width');
      if (resultsEmpty) resultsEmpty.hidden = false;
      if (resultsGrid)  resultsGrid.hidden  = true;
      return;
    }

    // Parse height (only when needed)
    let parsedHeight = parsedWidth; // default for square/circle/half-circle
    if (needsHeight) {
      const ph = normalizeInput(rawHeight, currentUnit);
      if (ph === null || ph <= 0) {
        showError(`"${rawHeight}" is not a valid height. Enter a number (48) or fraction (48 1/2).`, 'height');
        if (resultsEmpty) resultsEmpty.hidden = false;
        if (resultsGrid)  resultsGrid.hidden  = true;
        return;
      }
      parsedHeight = ph;
    }

    const widthMm  = toMm(parsedWidth,  currentUnit);
    const heightMm = toMm(parsedHeight, currentUnit);

    // Validate
    const widthVal  = validateGlassDimension(widthMm, 'width');
    const heightVal = validateGlassDimension(heightMm, 'height');

    if (!widthVal.valid && widthVal.level === 'error') {
      showError(widthVal.message ?? 'Invalid width.', 'width');
      if (resultsEmpty) resultsEmpty.hidden = false;
      if (resultsGrid)  resultsGrid.hidden  = true;
      return;
    }
    if (needsHeight && !heightVal.valid && heightVal.level === 'error') {
      showError(heightVal.message ?? 'Invalid height.', 'height');
      if (resultsEmpty) resultsEmpty.hidden = false;
      if (resultsGrid)  resultsGrid.hidden  = true;
      return;
    }

    const quantity   = Math.max(1, parseInt(qtyInput?.value ?? '1', 10));
    const glassType  = (glassTypeSelect?.value ?? 'annealed') as GlassType;

    // Run calculation
    const result = calculateGlass({
      widthMm,
      heightMm,
      shape:       currentShape,
      glassType,
      thicknessMm: currentThickness,
      quantity,
      wastePercent: currentWaste,
      edgeFinish:  currentEdge,
      holeCount:   currentHoles,
    });

    // Show top warning
    if (result.warnings.length > 0) showWarning(result.warnings[0].message);

    // Unit display
    if (unitDisplay) {
      const label = currentShape === 'circle' || currentShape === 'half-circle'
        ? `Ø ${parsedWidth} ${currentUnit}`
        : `${parsedWidth} × ${parsedHeight} ${currentUnit}`;
      unitDisplay.textContent = label;
    }

    // ── Area ──
    const areaCard = document.getElementById('result-area');
    const areaText = fmtArea(result.areaPerPieceM2, result.areaPerPieceSqFt);
    setResult(areaCard, areaText.split(' ')[0], areaText.split(' ').slice(1).join(' '));

    // ── Weight per piece ──
    const weightCard = document.getElementById('result-weight');
    setResult(weightCard, result.weightPerPieceKg.toFixed(1), `kg (${result.weightPerPieceLbs.toFixed(1)} lb)`);

    // ── Total weight ──
    const totalWCard = document.getElementById('result-total-weight');
    setResult(totalWCard, result.totalWeightKg.toFixed(1), `kg (${(result.totalWeightKg * 2.20462).toFixed(1)} lb)`);

    // ── Shipping weight ──
    const shipCard = document.getElementById('result-shipping');
    setResult(shipCard, result.shippingWeightKg.toFixed(1), 'kg');

    // ── Handling card ──
    const hCard  = document.getElementById('handling-card');
    const hIcon  = document.getElementById('handling-icon');
    const hTitle = document.getElementById('handling-title');
    const hNote  = document.getElementById('handling-note');
    if (hCard) {
      const cls = result.handlingClass;
      hCard.dataset.handling = cls;
      if (hIcon)  hIcon.textContent  = cls === 'solo' ? '🧍' : cls === 'two-person' ? '👥' : '🏗️';
      if (hTitle) hTitle.textContent = cls === 'solo' ? 'One person can handle this' : cls === 'two-person' ? 'Two people required' : 'Mechanical equipment required';
      if (hNote)  hNote.textContent  = result.handlingNote;
    }

    // ── Perimeter ──
    const perimCard = document.getElementById('result-perimeter');
    setResult(perimCard, fmtLen(result.perimeterMm), '');

    // ── Thickness ──
    const thickCard = document.getElementById('result-thickness');
    setResult(thickCard, result.totalThicknessMm.toFixed(1), 'mm');

    // ── Order planning ──
    setEl('result-pieces',     `${result.piecesNeededWithWaste} pcs`);
    setEl('result-total-area', fmtArea(result.totalAreaM2, result.totalAreaM2 * 10.764));
    setEl('result-area-waste', fmtArea(result.areaWithWasteM2, result.areaWithWasteM2 * 10.764));

    // ── Badges ──
    setEl('badge-rec-thickness', `${result.recommendedThicknessMm} mm${result.isTooThin ? ' ⚠️' : ' ✓'}`);
    const installLabels: Record<string, string> = { easy: 'DIY Easy', moderate: 'DIY Moderate', professional: 'Professional', contractor: 'Contractor' };
    setEl('badge-install',      installLabels[result.installDifficulty] ?? result.installDifficulty);
    const safetyLabels: Record<string, string> = { standard: 'Standard', 'impact-resistant': 'Impact Resistant', 'tempered-required': 'Safety Glass' };
    setEl('badge-safety',       safetyLabels[result.safetyClass] ?? result.safetyClass);
    setEl('badge-custom-fab',   result.customFabRequired ? 'Required ⚠️' : 'Not needed');

    // ── SVG ──
    const ar = (currentShape === 'rectangle' || currentShape === 'triangle')
      ? widthMm / heightMm
      : 1;
    const svgAreaLabel = fmtArea(result.areaPerPieceM2, result.areaPerPieceSqFt);
    updateSVG({
      shape:      currentShape,
      aspectRatio: ar,
      quantity,
      weightKg:  result.weightPerPieceKg,
      areaM2:    result.areaPerPieceM2,
      areaUnit:  svgAreaLabel,
    });

    // ── Recommendations section ──
    if (recCards) {
      recCards.innerHTML = '';
      result.recommendations.forEach((rec) => {
        const card = document.createElement('div');
        card.className = 'dyn-rec-card';
        card.innerHTML = `
          <div class="dyn-rec-top"><span class="dyn-rec-label">${rec.title}</span></div>
          <p class="dyn-rec-body">${rec.body}</p>
          ${rec.tip ? `<p class="dyn-rec-tip">${rec.tip}</p>` : ''}
        `;
        recCards.appendChild(card);
      });
    }

    // Warnings in rec section
    if (recWarnings) {
      recWarnings.innerHTML = '';
      result.warnings.forEach((w) => {
        const el = document.createElement('div');
        el.className = 'warning-banner';
        el.setAttribute('data-level', w.level);
        el.textContent = w.message;
        recWarnings.appendChild(el);
      });
    }

    // ── Buying guide ──
    if (buyingGuide) {
      const guide = result.buyingGuide;
      buyingGuide.hidden = false;
      setEl('buying-guide-title', guide.typeName);
      setEl('buying-guide-desc',  guide.description);

      const prosList = document.getElementById('buying-pros-list');
      if (prosList) { prosList.innerHTML = ''; guide.pros.forEach(p => { const li = document.createElement('li'); li.textContent = p; prosList.appendChild(li); }); }

      const consList = document.getElementById('buying-cons-list');
      if (consList) { consList.innerHTML = ''; guide.cons.forEach(c => { const li = document.createElement('li'); li.textContent = c; consList.appendChild(li); }); }

      const usesEl = document.getElementById('buying-uses-list');
      if (usesEl) { usesEl.innerHTML = ''; guide.typicalUses.forEach(u => { const chip = document.createElement('span'); chip.className = 'use-chip'; chip.textContent = u; usesEl.appendChild(chip); }); }

      const cuttableEl = document.getElementById('buying-cuttable');
      if (cuttableEl) {
        cuttableEl.textContent = guide.canCutAfterOrder ? '✓ Cuttable after ordering' : '✗ Cannot cut after ordering';
        cuttableEl.dataset.state = guide.canCutAfterOrder ? 'yes' : 'no';
      }
      const safetyEl = document.getElementById('buying-safety');
      if (safetyEl) {
        safetyEl.textContent = guide.safetyRated ? '✓ Safety-rated glass' : '✗ Not safety-rated';
        safetyEl.dataset.state = guide.safetyRated ? 'yes' : 'no';
      }
    }

    // ── Show results ──
    if (resultsEmpty) resultsEmpty.hidden = true;
    if (resultsGrid)  resultsGrid.hidden  = false;
    if (recSection)   recSection.hidden   = false;

    // ── Phase 5: URL state, history, share/export, analytics ─────────────────
    const glassInputs: Record<string, string> = {
      width:      rawWidth,
      height:     needsHeight ? rawHeight : rawWidth,
      unit:       currentUnit,
      shape:      currentShape,
      glassType,
      thickness:  String(currentThickness),
      qty:        String(quantity),
      waste:      String(currentWaste),
      edge:       currentEdge,
      holes:      String(currentHoles),
    };
    pushUrlState(glassInputs);

    const histLabel = `${parsedWidth}${needsHeight ? ' × ' + parsedHeight : ''} ${currentUnit} · ${glassType} ${currentThickness}mm · ${result.weightPerPieceKg.toFixed(1)} kg`;
    (window as any).wmHistoryPanel?.add(histLabel, glassInputs);
    (window as any).wmShareExportBar?.show();

    (window as any).wmCurrentState = glassInputs;
    (window as any).wmBuildSummary = () => buildSummary(
      'Window Glass Calculator',
      [
        ['Width',            `${rawWidth} ${currentUnit}`],
        ['Height',           needsHeight ? `${rawHeight} ${currentUnit}` : `${rawWidth} ${currentUnit}`],
        ['Shape',            currentShape],
        ['Glass Type',       glassType],
        ['Thickness',        `${currentThickness} mm`],
        ['Quantity',         String(quantity)],
        ['Area per Piece',   fmtArea(result.areaPerPieceM2, result.areaPerPieceSqFt)],
        ['Weight per Piece', `${result.weightPerPieceKg.toFixed(1)} kg`],
        ['Total Weight',     `${result.totalWeightKg.toFixed(1)} kg`],
        ['Handling',         result.handlingClass.replace('-', ' ')],
        ['Custom Fab?',      result.customFabRequired ? 'Yes' : 'No'],
      ],
      buildShareUrl(glassInputs),
    );
    (window as any).wmBuildExport = () => buildExportPayload(
      'window-glass-calculator',
      glassInputs,
      {
        areaPerPieceM2:    result.areaPerPieceM2,
        areaPerPieceSqFt:  result.areaPerPieceSqFt,
        weightPerPieceKg:  result.weightPerPieceKg,
        totalWeightKg:     result.totalWeightKg,
        shippingWeightKg:  result.shippingWeightKg,
        handlingClass:     result.handlingClass,
        customFabRequired: result.customFabRequired,
        recommendedThicknessMm: result.recommendedThicknessMm,
      },
    );

    track({
      type: 'calculation_completed',
      properties: { slug: 'window-glass-calculator', unit: currentUnit, inputs: glassInputs },
    });

    // Mobile scroll
    if (resultsGrid && window.innerWidth < 768) {
      resultsGrid.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  // Initial restore
  if (widthInput?.value) calculate();
</script>

