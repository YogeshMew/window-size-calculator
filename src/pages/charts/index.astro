---
/**
 * WindowMetrics — Charts Index
 * Information-dense regional chart previews.
 */

import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/global/Breadcrumbs.astro';
import { getCanonical } from '@/lib/seo.js';
import { getCollection } from 'astro:content';
import type { BreadcrumbItem } from '@/types/calculator.js';

const canonical = getCanonical('/charts');
const charts    = await getCollection('charts', ({ data }) => !data.draft);

const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Home', href: '/' },
  { label: 'Charts', href: '/charts', current: true },
];

const upcomingCharts = [
  {
    flag: '🇺🇸',
    region:   'United States',
    standard: 'ANSI / AAMA',
    system:   'Imperial (in)',
    status:   'Drafting',
    unit:     'inches',
    preview: [
      { type: 'Single Hung',  size: '36 × 72' },
      { type: 'Double Hung',  size: '36 × 60' },
      { type: 'Casement',     size: '24 × 48' },
      { type: 'Sliding',      size: '60 × 48' },
    ],
  },
  {
    flag: '🇬🇧',
    region:   'United Kingdom',
    standard: 'BS 6375',
    system:   'Metric (mm)',
    status:   'Drafting',
    unit:     'mm',
    preview: [
      { type: 'Casement',     size: '630 × 1050' },
      { type: 'Sash',         size: '900 × 1200' },
      { type: 'Tilt & Turn',  size: '1200 × 1200' },
      { type: 'Fixed',        size: '600 × 900' },
    ],
  },
  {
    flag: '🇨🇦',
    region:   'Canada',
    standard: 'NBC',
    system:   'Imperial + Metric',
    status:   'Planned',
    unit:     'inches',
    preview: [
      { type: 'Single Hung',  size: '30 × 54' },
      { type: 'Casement',     size: '24 × 36' },
      { type: 'Sliding',      size: '48 × 60' },
      { type: 'Fixed',        size: '36 × 60' },
    ],
  },
  {
    flag: '🇦🇺',
    region:   'Australia',
    standard: 'AS 2047',
    system:   'Metric (mm)',
    status:   'Planned',
    unit:     'mm',
    preview: [
      { type: 'Casement',     size: '600 × 900' },
      { type: 'Awning',       size: '900 × 600' },
      { type: 'Sliding',      size: '1200 × 1200' },
      { type: 'Fixed',        size: '900 × 1200' },
    ],
  },
  {
    flag: '🇪🇺',
    region:   'Europe',
    standard: 'EN 14351',
    system:   'Metric (mm)',
    status:   'Planned',
    unit:     'mm',
    preview: [
      { type: 'Tilt & Turn',  size: '900 × 1200' },
      { type: 'Casement',     size: '600 × 1000' },
      { type: 'Fixed',        size: '1200 × 1500' },
      { type: 'Sliding',      size: '2400 × 2100' },
    ],
  },
  {
    flag: '🌍',
    region:   'Global Comparison',
    standard: 'All standards',
    system:   'Both',
    status:   'Planned',
    unit:     '',
    preview: [
      { type: 'US 36 × 72"',     size: '≈ 914 × 1829 mm' },
      { type: 'UK 630 × 1050mm', size: '≈ 25 × 41"' },
      { type: 'EU 900 × 1200mm', size: '≈ 35 × 47"' },
      { type: 'AU 900 × 1200mm', size: '≈ 35 × 47"' },
    ],
  },
];
---

<Layout
  title="Window Size Charts & Reference Tables"
  description="Standard window size charts for the US, UK, Canada, Australia, and Europe. Reference tables for double-hung, casement, sliding, and more."
  canonical={canonical}
>
  <div class="charts-topbar">
    <div class="container-content">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </div>

  <div class="container-content charts-page">

    <header class="charts-header">
      <h1 class="charts-h1">Window Size Charts</h1>
      <p class="charts-lead">
        Standard window size reference tables for the US, UK, Canada, Australia, and Europe.
        Based on ANSI, BS, AS, and EN standards.
      </p>
    </header>

    {
      charts.length > 0 ? (
        <div class="charts-grid">
          {charts.map((chart) => (
            <a href={`/charts/${chart.id}`} class="chart-card">
              <h2 class="chart-card-title">{chart.data.title}</h2>
              <p class="chart-card-desc">{chart.data.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <div class="upcoming">
          <div class="upcoming-bar">
            <span class="upcoming-chip">Coming soon</span>
            <span class="upcoming-note">
              We're compiling verified data from ANSI, BS 6375, AS 2047, and EN 14351 standards.
            </span>
          </div>

          <div class="charts-grid">
            {upcomingCharts.map((chart) => (
              <div class="chart-card chart-card--preview">
                <!-- Top: flag + status -->
                <div class="chart-card-top">
                  <div class="chart-region-row">
                    <span class="chart-flag" aria-hidden="true">{chart.flag}</span>
                    <span class="chart-region">{chart.region}</span>
                  </div>
                  <span class:list={[
                    'chart-status',
                    chart.status === 'Drafting' ? 'chart-status--drafting' : 'chart-status--planned'
                  ]}>
                    {chart.status}
                  </span>
                </div>

                <!-- Standard + measurement system -->
                <div class="chart-meta-grid">
                  <div class="chart-meta-item">
                    <span class="chart-meta-key">Standard</span>
                    <span class="chart-meta-val">{chart.standard}</span>
                  </div>
                  <div class="chart-meta-item">
                    <span class="chart-meta-key">Units</span>
                    <span class="chart-meta-val">{chart.system}</span>
                  </div>
                </div>

                <!-- Mini preview table -->
                <div class="chart-preview-wrap">
                  <span class="chart-preview-label">
                    Sample sizes{chart.unit ? ` (${chart.unit})` : ''}
                  </span>
                  <table class="chart-preview-table" aria-label={`Sample ${chart.region} window sizes`}>
                    <thead>
                      <tr>
                        <th>Type</th>
                        <th>Nominal size</th>
                      </tr>
                    </thead>
                    <tbody>
                      {chart.preview.map((row) => (
                        <tr>
                          <td>{row.type}</td>
                          <td>{row.size}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
          </div>

        </div>
      )
    }

    <div class="charts-cta">
      <p class="charts-cta-text">Have your measurements? Find your standard size instantly.</p>
      <a href="/tools/window-size-calculator" class="charts-cta-link">Open Window Size Calculator →</a>
    </div>

  </div>
</Layout>

<style>
  .charts-topbar {
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid var(--color-hairline);
    background-color: var(--color-canvas-soft);
  }

  .charts-page {
    padding-block: var(--spacing-2xl) var(--spacing-5xl);
  }

  .charts-header {
    padding-bottom: var(--spacing-xl);
    border-bottom: 1px solid var(--color-hairline);
    margin-bottom: var(--spacing-2xl);
  }

  .charts-h1 {
    font-size: var(--font-size-display-md);
    font-weight: 600;
    letter-spacing: var(--tracking-display-md);
    margin: 0 0 var(--spacing-xs);
  }

  .charts-lead {
    font-size: var(--font-size-body-sm);
    color: var(--color-body);
    max-width: 520px;
    margin: 0;
    line-height: 1.6;
  }

  /* Upcoming notice */
  .upcoming-bar {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
    margin-bottom: var(--spacing-xl);
  }

  .upcoming-chip {
    font-family: var(--font-family-mono);
    font-size: 11px;
    color: var(--color-muted);
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: 3px;
    padding: 2px 7px;
    letter-spacing: 0.03em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .upcoming-note {
    font-size: var(--font-size-caption);
    color: var(--color-muted);
    line-height: 1.5;
  }

  /* Chart grid */
  .charts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-3xl);
  }

  .chart-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    padding: var(--spacing-md);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms ease, transform 150ms ease;
  }

  a.chart-card:hover {
    border-color: var(--color-hairline-strong);
    transform: translateY(-1px);
  }

  .chart-card--preview {
    opacity: 0.72;
  }

  /* Card top row */
  .chart-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-xs);
  }

  .chart-region-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .chart-flag {
    font-size: 16px;
    line-height: 1;
    flex-shrink: 0;
  }

  .chart-region {
    font-size: var(--font-size-body-sm);
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }

  .chart-status {
    font-family: var(--font-family-mono);
    font-size: 10px;
    padding: 1px 5px;
    border-radius: 3px;
    letter-spacing: 0.03em;
    flex-shrink: 0;
  }

  .chart-status--drafting {
    color: #b45309;
    background-color: color-mix(in srgb, #f59e0b 8%, transparent);
    border: 1px solid color-mix(in srgb, #f59e0b 15%, transparent);
  }

  [data-theme='dark'] .chart-status--drafting {
    color: #fbbf24;
  }

  .chart-status--planned {
    color: var(--color-muted);
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
  }

  /* Meta grid */
  .chart-meta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm);
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
  }

  .chart-meta-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .chart-meta-key {
    font-family: var(--font-family-mono);
    font-size: 9px;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .chart-meta-val {
    font-size: var(--font-size-caption);
    font-weight: 500;
    color: var(--color-ink);
  }

  /* Mini preview table */
  .chart-preview-wrap {
    margin-top: var(--spacing-sm);
    padding-top: var(--spacing-sm);
    border-top: 1px solid var(--color-hairline);
  }

  .chart-preview-label {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 9px;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: var(--spacing-xs);
  }

  .chart-preview-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-family-mono);
    font-size: 11px;
  }

  .chart-preview-table thead th {
    font-size: 9px;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
    padding: 0 4px 4px 0;
    text-align: left;
    border-bottom: 1px solid var(--color-hairline);
  }

  .chart-preview-table tbody td {
    padding: 4px 4px 0 0;
    color: var(--color-body);
    line-height: 1.3;
    vertical-align: top;
  }

  .chart-preview-table tbody td:last-child {
    font-weight: 600;
    color: var(--color-ink);
    text-align: right;
    padding-right: 0;
  }

  .chart-preview-table tbody tr:first-child td {
    padding-top: var(--spacing-xs);
  }

  /* Card title/desc for live charts */
  .chart-card-title {
    font-size: var(--font-size-body-sm);
    font-weight: 600;
    color: var(--color-ink);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .chart-card-desc {
    font-size: var(--font-size-caption);
    color: var(--color-body);
    margin: 0;
    line-height: 1.55;
  }

  /* CTA bar */
  .charts-cta {
    margin-top: var(--spacing-3xl);
    padding: var(--spacing-lg) var(--spacing-xl);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas-soft);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-lg);
    flex-wrap: wrap;
  }

  .charts-cta-text {
    font-size: var(--font-size-body-sm);
    font-weight: 500;
    color: var(--color-ink);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .charts-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 36px;
    padding: 0 var(--spacing-md);
    font-size: var(--font-size-body-sm);
    font-weight: 500;
    color: var(--color-canvas);
    background-color: var(--color-ink);
    border-radius: var(--radius-sm);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 150ms ease;
    letter-spacing: -0.01em;
  }

  .charts-cta-link:hover { opacity: 0.82; }
</style>
