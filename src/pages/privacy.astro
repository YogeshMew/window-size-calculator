---
/**
 * WindowMetrics — Privacy Policy Page
 */

import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/global/Breadcrumbs.astro';
import { getCanonical } from '@/lib/seo.js';
import type { BreadcrumbItem } from '@/types/calculator.js';

const canonical = getCanonical('/privacy');
const lastUpdated = new Date('2025-01-01');
const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Home', href: '/' },
  { label: 'Privacy Policy', href: '/privacy', current: true },
];
---

<Layout
  title="Privacy Policy"
  description="WindowMetrics privacy policy — how we collect, use, and protect your information."
  canonical={canonical}
>
  <div class="page-breadcrumbs">
    <div class="container-content">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </div>

  <div class="container-narrow privacy-page">
    <h1>Privacy Policy</h1>
    <p class="last-updated">
      Last updated:{' '}
      <time datetime={lastUpdated.toISOString()}>
        {lastUpdated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
    </p>

    <h2>Information we collect</h2>
    <p>
      WindowMetrics calculators run entirely in your browser. Measurements you enter are not
      transmitted to our servers and are not stored.
    </p>

    <h2>Cookies and local storage</h2>
    <p>
      We use browser local storage to remember your theme preference (light or dark mode). No
      tracking cookies are used at this time.
    </p>

    <h2>Third-party services</h2>
    <p>
      We may use analytics services in the future to understand how our tools are used. Any such
      services will be listed here before they are enabled.
    </p>

    <h2>Contact</h2>
    <p>
      For privacy questions, please contact us through our <a href="/about">About</a> page.
    </p>
  </div>
</Layout>

<style>
  .page-breadcrumbs {
    padding: var(--spacing-md) 0;
    border-bottom: 1px solid var(--color-hairline);
    background-color: var(--color-canvas-soft);
    margin-bottom: var(--spacing-2xl);
  }

  .privacy-page {
    padding-bottom: var(--spacing-5xl);
  }

  .last-updated {
    font-size: var(--font-size-body-sm);
    color: var(--color-muted);
    font-family: var(--font-family-mono);
    margin-bottom: var(--spacing-2xl);
  }

  h2 {
    margin-top: var(--spacing-2xl);
    margin-bottom: var(--spacing-md);
  }
</style>
