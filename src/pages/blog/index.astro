---
/**
 * WindowMetrics — Blog Index
 * Article card layout with category, draft badge, reading time.
 */

import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/global/Breadcrumbs.astro';
import { getCanonical } from '@/lib/seo.js';
import { getCollection } from 'astro:content';
import type { BreadcrumbItem } from '@/types/calculator.js';

const canonical     = getCanonical('/blog');
const posts         = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

/** Get the first tag as a display category */
function getCategory(tags: string[]): string {
  return tags[0] ? tags[0].charAt(0).toUpperCase() + tags[0].slice(1) : 'Article';
}

const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog', current: true },
];

const upcomingPosts = [
  {
    category: 'Buying Guide',
    readTime: '10 min',
    title: 'The Complete Guide to Buying Replacement Windows in 2026',
    desc: 'Frame materials, glass types, energy ratings, installation costs, and everything else you need to know before buying replacement windows.',
    author: 'WindowMetrics Editorial',
    initials: 'WM',
  },
  {
    category: 'DIY',
    readTime: '5 min',
    title: 'How to Measure a Window in 5 Minutes (and Get It Right)',
    desc: 'A simple, mistake-proof method for measuring windows for replacement — including what to do when your opening is out of square.',
    author: 'WindowMetrics Editorial',
    initials: 'WM',
  },
  {
    category: 'Energy',
    readTime: '8 min',
    title: 'Double vs Triple Pane Windows: Is the Upgrade Worth It?',
    desc: 'A data-driven comparison of double and triple pane windows — energy savings, payback period, and climate zone recommendations.',
    author: 'WindowMetrics Editorial',
    initials: 'WM',
  },
  {
    category: 'Curtains',
    readTime: '4 min',
    title: 'Curtain Width Calculator: The Formula That Actually Works',
    desc: 'Why the "1.5× window width" rule is wrong for most windows, and the correct formula for full, professionally styled curtains.',
    author: 'WindowMetrics Editorial',
    initials: 'WM',
  },
];
---

<Layout
  title="WindowMetrics Blog"
  description="Window measurement tips, buying guides, replacement planning resources, and DIY advice for homeowners and contractors."
  canonical={canonical}
>
  <div class="blog-topbar">
    <div class="container-content">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </div>

  <div class="container-content blog-page">

    <header class="blog-header">
      <h1 class="blog-h1">Blog</h1>
      <p class="blog-lead">
        Buying guides, measurement tips, DIY advice, and resources for anyone dealing with
        windows — from quick repairs to full replacements.
      </p>
    </header>

    {
      sortedPosts.length > 0 ? (
        <>
          <div class="blog-featured">
            <div class="blog-featured-meta">
              <span class="post-category">{getCategory(sortedPosts[0].data.tags)}</span>
              <time datetime={sortedPosts[0].data.publishedAt.toISOString()} class="post-date">
                {sortedPosts[0].data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </div>
            <h2 class="blog-featured-title">{sortedPosts[0].data.title}</h2>
            <p class="blog-featured-excerpt">{sortedPosts[0].data.excerpt ?? sortedPosts[0].data.description}</p>
            <a href={`/blog/${sortedPosts[0].id}`} class="blog-featured-link">Read article →</a>
          </div>

          {sortedPosts.length > 1 && (
            <div class="post-list">
              {sortedPosts.slice(1).map((post) => (
                <a href={`/blog/${post.id}`} class="post-card">
                  <div class="post-card-meta">
                    <span class="post-category">{getCategory(post.data.tags)}</span>
                    <span class="post-divider" aria-hidden="true">·</span>
                    <time datetime={post.data.publishedAt.toISOString()} class="post-date">
                      {post.data.publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                    </time>
                  </div>
                  <h2 class="post-title">{post.data.title}</h2>
                  <p class="post-desc">{post.data.excerpt ?? post.data.description}</p>
                  <span class="post-read-more">Read article →</span>
                </a>
              ))}
            </div>
          )}
        </>
      ) : (
        <div class="blog-upcoming">
          <div class="upcoming-bar">
            <span class="upcoming-chip">Coming soon</span>
            <span class="upcoming-note">We're writing our first articles — here's what's coming.</span>
          </div>

          <div class="upcoming-grid">
            {upcomingPosts.map((post) => (
              <div class="upcoming-card">
                <div class="upcoming-card-meta">
                  <span class="post-category">{post.category}</span>
                  <span class="post-divider" aria-hidden="true">·</span>
                  <span class="post-date">{post.readTime} read</span>
                  <span class="post-divider" aria-hidden="true">·</span>
                  <span class="upcoming-coming-inline">Coming soon</span>
                </div>
                <h2 class="upcoming-title">{post.title}</h2>
                <p class="upcoming-desc">{post.desc}</p>
                <div class="upcoming-card-footer">
                  <div class="upcoming-author-row">
                    <span class="upcoming-avatar" aria-hidden="true">{post.initials}</span>
                    <span class="upcoming-author">{post.author}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <div class="blog-cta-row">
            <p class="blog-cta-text">While you wait, try our free calculators</p>
            <div class="blog-cta-links">
              <a href="/tools/window-size-calculator" class="blog-cta-link">Window Size Calculator →</a>
              <a href="/charts" class="blog-cta-link">Standard Size Charts →</a>
              <a href="/guides" class="blog-cta-link">Measurement Guides →</a>
            </div>
          </div>
        </div>
      )
    }

  </div>
</Layout>

<style>
  .blog-topbar {
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid var(--color-hairline);
    background-color: var(--color-canvas-soft);
  }

  .blog-page {
    padding-block: var(--spacing-2xl) var(--spacing-5xl);
  }

  .blog-header {
    padding-bottom: var(--spacing-xl);
    border-bottom: 1px solid var(--color-hairline);
    margin-bottom: var(--spacing-2xl);
  }

  .blog-h1 {
    font-size: var(--font-size-display-md);
    font-weight: 600;
    letter-spacing: var(--tracking-display-md);
    margin: 0 0 var(--spacing-xs);
  }

  .blog-lead {
    font-size: var(--font-size-body-sm);
    color: var(--color-body);
    max-width: 520px;
    margin: 0;
    line-height: 1.6;
  }

  /* Upcoming bar */
  .upcoming-bar {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xl);
  }

  .upcoming-chip {
    font-family: var(--font-family-mono);
    font-size: 11px;
    color: var(--color-muted);
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: 3px;
    padding: 2px 7px;
    letter-spacing: 0.03em;
  }

  .upcoming-note {
    font-size: var(--font-size-caption);
    color: var(--color-muted);
  }

  /* Post list */
  .post-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    max-width: 680px;
    margin-bottom: var(--spacing-3xl);
  }

  /* Post cards */
  .post-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    padding: var(--spacing-md) 0;
    background-color: transparent;
    border-bottom: 1px solid var(--color-hairline);
    text-decoration: none;
    color: inherit;
    transition: opacity 150ms ease;
  }
  .post-card:last-child {
    border-bottom: none;
  }

  a.post-card:hover {
    opacity: 0.8;
  }

  .post-card--draft {
    opacity: 0.65;
  }

  /* Meta row */
  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .post-category {
    font-family: var(--font-family-mono);
    font-size: 10px;
    color: var(--color-muted);
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: 3px;
    padding: 1px 5px;
    letter-spacing: 0.03em;
  }

  .post-divider {
    font-size: var(--font-size-caption);
    color: var(--color-hairline-strong);
  }

  .post-date,
  .post-read-time {
    font-family: var(--font-family-mono);
    font-size: 11px;
    color: var(--color-muted);
    letter-spacing: 0.02em;
  }

  .post-draft-badge {
    font-family: var(--font-family-mono);
    font-size: 10px;
    color: var(--color-muted);
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: 3px;
    padding: 1px 5px;
    opacity: 0.7;
  }

  /* Titles */
  .post-title {
    font-size: var(--font-size-body-md);
    font-weight: 600;
    color: var(--color-ink);
    margin: 0;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .post-desc {
    font-size: var(--font-size-body-sm);
    color: var(--color-body);
    margin: 0;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-read-more {
    font-family: var(--font-family-mono);
    font-size: 11px;
    color: var(--color-link);
    margin-top: 2px;
  }

  .post-card-footer {
    margin-top: 4px;
    padding-top: var(--spacing-xs);
    border-top: 1px solid var(--color-hairline);
  }

  .post-author {
    font-family: var(--font-family-mono);
    font-size: 10px;
    color: var(--color-muted);
    letter-spacing: 0.03em;
  }

  /* Custom layout styles */
  .blog-featured { padding: var(--spacing-xl); background: var(--color-canvas-soft); border: 1px solid var(--color-hairline); border-radius: var(--radius-lg); margin-bottom: var(--spacing-2xl); }
  .blog-featured-meta { display: flex; gap: var(--spacing-sm); align-items: center; margin-bottom: var(--spacing-sm); }
  .blog-featured-title { font-size: var(--font-size-display-sm); margin: 0 0 var(--spacing-sm); color: var(--color-ink); }
  .blog-featured-excerpt { font-size: var(--font-size-body-md); color: var(--color-body); margin: 0 0 var(--spacing-lg); line-height: 1.6; }
  .blog-featured-link { font-family: var(--font-family-mono); font-size: 13px; font-weight: 600; color: var(--color-link); text-decoration: none; }
  
  /* Upcoming posts — when no published articles yet */
  .blog-upcoming {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xl);
  }

  .upcoming-bar {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .upcoming-chip {
    font-family: var(--font-family-mono);
    font-size: 11px;
    color: var(--color-muted);
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: 3px;
    padding: 2px 7px;
    letter-spacing: 0.03em;
    flex-shrink: 0;
  }

  .upcoming-note {
    font-size: var(--font-size-caption);
    color: var(--color-muted);
  }

  .upcoming-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--spacing-sm);
  }

  .upcoming-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    padding: var(--spacing-lg);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    opacity: 0.7;
  }

  .upcoming-card-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .upcoming-title {
    font-size: var(--font-size-body-sm);
    font-weight: 600;
    color: var(--color-ink);
    margin: 0;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .upcoming-desc {
    font-size: var(--font-size-caption);
    color: var(--color-body);
    margin: 0;
    flex: 1;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .upcoming-card-footer {
    padding-top: var(--spacing-xs);
    border-top: 1px solid var(--color-hairline);
    margin-top: auto;
  }

  .upcoming-author-row {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .upcoming-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    font-family: var(--font-family-mono);
    font-size: 8px;
    font-weight: 600;
    color: var(--color-muted);
    letter-spacing: 0;
    flex-shrink: 0;
  }

  .upcoming-author {
    font-family: var(--font-family-mono);
    font-size: 10px;
    color: var(--color-muted);
    letter-spacing: 0.02em;
  }

  .upcoming-coming-inline {
    font-family: var(--font-family-mono);
    font-size: 10px;
    color: var(--color-muted);
    letter-spacing: 0.03em;
  }

  /* Blog CTA row at bottom of empty state */
  .blog-cta-row {
    padding: var(--spacing-xl);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas-soft);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  @media (min-width: 600px) {
    .blog-cta-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .blog-cta-text {
    font-size: var(--font-size-body-sm);
    font-weight: 500;
    color: var(--color-ink);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .blog-cta-links {
    display: flex;
    gap: var(--spacing-lg);
    flex-wrap: wrap;
  }

  .blog-cta-link {
    font-family: var(--font-family-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-link);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 150ms ease;
  }

  .blog-cta-link:hover {
    opacity: 0.75;
  }
</style>
